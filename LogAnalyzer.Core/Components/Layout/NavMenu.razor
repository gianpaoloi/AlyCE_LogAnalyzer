@inject IJSRuntime JS
@inject NotificationService Notifications

@* No Bootstrap spacing utilities here: the padding is set in CSS instead, so the narrow sidebar
   keeps as much width as possible for the labels. *@
<div class="top-row navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">AlyCE Log Analyzer</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @* Icons come from the Material Symbols font Radzen already ships, so they match the icons on
           every button in the app and inherit the link colour as it changes between states. *@
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon" aria-hidden="true"><RadzenIcon Icon="dashboard" /></span> Overview
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="explorer">
                <span class="nav-icon" aria-hidden="true"><RadzenIcon Icon="manage_search" /></span> Explorer
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="triage">
                <span class="nav-icon" aria-hidden="true"><RadzenIcon Icon="warning" /></span> Triage
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="live">
                <span class="nav-icon" aria-hidden="true"><RadzenIcon Icon="sensors" /></span> Live watch
            </NavLink>
        </div>
    </nav>

    @* Pinned to the bottom of the sidebar so the running version is always on screen — it is the
       first thing a bug report needs, and it is read from the assembly, so it cannot go stale. *@
    <button type="button" class="nav-version" @onclick="CopyVersion" title="@Tooltip">
        @* Parenthesised on purpose: bare "v@AppVersion.Display" looks like an email address to the
           Razor parser, which then emits it as literal text. *@
        <span class="nav-version-text">v@(AppVersion.Display)</span>
        <span class="nav-version-copy" aria-hidden="true">&#x29C9;</span>
    </button>
</div>

@code {
    private static string Tooltip =>
        AppVersion.Commit is null
            ? $"Version {AppVersion.Display} — click to copy"
            : $"Version {AppVersion.Display} (commit {AppVersion.ShortCommit}) — click to copy";

    private async Task CopyVersion()
    {
        try
        {
            await JS.InvokeVoidAsync("copyTextToClipboard", AppVersion.Full);
            Notify(NotificationSeverity.Success, "Copied", AppVersion.Full);
        }
        catch
        {
            // No clipboard (policy, or a non-secure context): show the value so it can be read off.
            Notify(NotificationSeverity.Info, "Version", AppVersion.Full);
        }
    }

    private void Notify(NotificationSeverity severity, string summary, string detail) =>
        Notifications.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = 4000,
        });
}
