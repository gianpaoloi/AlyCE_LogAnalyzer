@inject IJSRuntime JS
@inject NotificationService Notifications
@inject DialogService Dialogs
@inject UpdateChecker Updates
@inject Localizer L

@* No Bootstrap spacing utilities here: the padding is set in CSS instead, so the narrow sidebar
   keeps as much width as possible for the labels. *@
<div class="top-row navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">AlyCE Log Analyzer</a>
    </div>
</div>

<input type="checkbox" title="@(L["nav.navigationMenu"])" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    @* Two groups, because the pages answer two different questions: the first three work on a set of
       files already on disk, the last two on events arriving right now. Plain headings rather than
       collapsible sections — five items never need folding away, and a nav item that hides itself is
       one you have to remember is there. *@
    <nav class="flex-column">
        @* Icons come from the Material Symbols font Radzen already ships, so they match the icons on
           every button in the app and inherit the link colour as it changes between states. *@
        <h2 class="nav-group">@L["nav.fileAnalysis"]</h2>
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon" aria-hidden="true"><RadzenIcon Icon="dashboard" /></span> @L["nav.overview"]
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="explorer">
                <span class="nav-icon" aria-hidden="true"><RadzenIcon Icon="manage_search" /></span> @L["nav.explorer"]
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="triage">
                <span class="nav-icon" aria-hidden="true"><RadzenIcon Icon="warning" /></span> @L["nav.triage"]
            </NavLink>
        </div>

        <h2 class="nav-group">@L["nav.liveWatch"]</h2>
        <div class="nav-item">
            <NavLink class="nav-link" href="live">
                <span class="nav-icon" aria-hidden="true"><RadzenIcon Icon="sensors" /></span> @L["nav.fileLiveWatch"]
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="network">
                <span class="nav-icon" aria-hidden="true"><RadzenIcon Icon="lan" /></span> @L["nav.networkLiveWatch"]
            </NavLink>
        </div>

        <h2 class="nav-group">@L["nav.appearance"]</h2>
        <div class="nav-item">
            <NavLink class="nav-link" href="skins">
                <span class="nav-icon" aria-hidden="true"><RadzenIcon Icon="palette" /></span> @L["nav.skinEditor"]
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="languages">
                <span class="nav-icon" aria-hidden="true"><RadzenIcon Icon="translate" /></span> @L["nav.languageEditor"]
            </NavLink>
        </div>
    </nav>

    @* Only appears once the check has come back with something newer, so the sidebar has nothing
       extra in it on the overwhelmingly common day when the app is current. *@
    @if (_update is not null)
    {
        <button type="button" class="nav-update" @onclick="ShowUpdate"
                title="@(L["layout.updateTip", _update.Version])">
            <span class="nav-icon" aria-hidden="true"><RadzenIcon Icon="system_update_alt" /></span>
            <span class="nav-update-text">@L["layout.updateTo", _update.Version]</span>
        </button>
    }

    @* Pinned to the bottom of the sidebar so the running version is always on screen — it is the
       first thing a bug report needs, and it is read from the assembly, so it cannot go stale.

       The version itself links out to the releases page; the glyph beside it still copies the full
       version, which is the value a bug report wants and is not something a link can give you. An
       <a> rather than a click handler because that is what already opens GitHub for the About link,
       and it is what the WebView hands to the system browser. *@
    <div class="nav-version">
        <a class="nav-version-link" href="@Updates.Options.ReleasesPageUrl" target="_blank"
           rel="noopener noreferrer" title="@Tooltip">
            @* Parenthesised on purpose: bare "v@AppVersion.Display" looks like an email address to
               the Razor parser, which then emits it as literal text. *@
            <span class="nav-version-text">v@(AppVersion.Display)</span>
        </a>
        <button type="button" class="nav-version-copy" @onclick="CopyVersion" title="@CopyTooltip">
            <span aria-hidden="true">&#x29C9;</span>
        </button>
    </div>
</div>

@implements IDisposable

@code {
    private UpdateInfo? _update;

    // The sidebar has no parameters, so Blazor does not redraw it when the page redraws. It listens for a
    // language change itself, so its labels change at once instead of on the next click.
    protected override void OnInitialized() => L.Changed += OnLanguageChanged;

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnLanguageChanged;

    /// <summary>
    /// Asked for after the first paint rather than in OnInitialized: the sidebar must not wait on
    /// a network round trip to github.com, which on a machine behind a proxy means waiting for a
    /// timeout. The checker caches, so navigating between pages does not repeat the request.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var result = await Updates.CheckAsync();
        if (!result.IsUpdateAvailable) return;

        _update = result.Release;

        try
        {
            StateHasChanged();
        }
        catch (ObjectDisposedException)
        {
            // The window was closed, or the circuit dropped, while GitHub was answering. There is
            // nothing left to re-render and nothing to tell anyone about.
        }
    }

    private async Task ShowUpdate()
    {
        if (_update is null) return;

        await Dialogs.OpenAsync<UpdateDialog>(L["layout.updateAvailable", _update.Version],
            new Dictionary<string, object?> { { "Release", _update } },
            new DialogOptions { Width = "680px", Resizable = true, Draggable = true });
    }

    private string Tooltip =>
        AppVersion.Commit is null
            ? L["layout.versionTip", AppVersion.Display]
            : L["layout.versionTipCommit", AppVersion.Display, AppVersion.ShortCommit];

    private string CopyTooltip => L["layout.copyVersion", AppVersion.Full];

    private async Task CopyVersion()
    {
        try
        {
            await JS.InvokeVoidAsync("copyTextToClipboard", AppVersion.Full);
            Notify(NotificationSeverity.Success, L["layout.copied"], AppVersion.Full);
        }
        catch
        {
            // No clipboard (policy, or a non-secure context): show the value so it can be read off.
            Notify(NotificationSeverity.Info, L["layout.version"], AppVersion.Full);
        }
    }

    private void Notify(NotificationSeverity severity, string summary, string detail) =>
        Notifications.Notify(new NotificationMessage
        {
            Severity = severity,
            Summary = summary,
            Detail = detail,
            Duration = 4000,
        });
}
