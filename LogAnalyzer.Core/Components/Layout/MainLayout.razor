@inherits LayoutComponentBase
@implements IDisposable

<RadzenComponents />

<div class="page @(_navCollapsed ? "nav-collapsed" : null)">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <button class="nav-toggle" @onclick="ToggleNav" title="@(L["layout.toggleMenu"])" aria-label="@(L["layout.toggleMenu"])">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
            <NavLink href="/quick-info"><span class="top-link-icon" aria-hidden="true"><RadzenIcon Icon="rocket_launch" /></span><span>@L["layout.quickInfo"]</span></NavLink>
            <NavLink href="/changelog"><span class="top-link-icon" aria-hidden="true"><RadzenIcon Icon="history" /></span><span>@L["layout.changelog"]</span></NavLink>
            <NavLink href="/feedback"><span class="top-link-icon" aria-hidden="true"><RadzenIcon Icon="feedback" /></span><span>@L["layout.feedback"]</span></NavLink>
            <NavLink href="/resources"><span class="top-link-icon" aria-hidden="true"><RadzenIcon Icon="memory" /></span><span>@L["layout.resources"]</span></NavLink>
            <NavLink href="/ai"><span class="top-link-icon" aria-hidden="true"><RadzenIcon Icon="smart_toy" /></span><span>@L["ai.title"]</span></NavLink>
            @* The GitHub mark is inline SVG: Material Icons has no brand glyph. This link leaves the app for GitHub. *@
            <a href="https://github.com/gianpaoloi/AlyCE_LogAnalyzer" target="_blank" rel="noopener noreferrer"><span class="top-link-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg></span><span>@L["layout.github"]</span></a>
            <div class="skin-quick">
                @* The button shows the icon; the open list shows the language names. *@
                <TopBarMenu Icon="translate" Title="@(L["layout.language"])" Items="@_languageItems"
                            Current="@L.CurrentCode" Selected="OnLanguageSelected" />
            </div>
            <div class="skin-quick">
                @* The button shows the icon; the open list shows the skin names. *@
                <TopBarMenu Icon="palette" Title="@(L["layout.skin"])" Items="@_skinItems"
                            Current="@_activeSkinName" Selected="OnSkinSelected" />
            </div>
        </div>

        <article class="content px-4">
            @* A new key on language change rebuilds the page in the new language; the app's data lives in services, so it is kept. *@
            <div @key="_langVersion">
                @Body
            </div>
        </article>
    </main>
</div>

@code {
    private bool _navCollapsed;
    private bool _skinApplied;
    private IReadOnlyList<string> _skinNames = Array.Empty<string>();
    private IReadOnlyList<TopBarMenuItem> _skinItems = Array.Empty<TopBarMenuItem>();
    private string _activeSkinName = SkinCatalog.DefaultName;

    private int _langVersion;
    private IReadOnlyList<TopBarMenuItem> _languageItems = Array.Empty<TopBarMenuItem>();

    [Inject] private SkinStore Skins { get; set; } = default!;
    [Inject] private Localizer L { get; set; } = default!;
    [Inject] private LanguageStore Languages { get; set; } = default!;

    private void ToggleNav() => _navCollapsed = !_navCollapsed;

    protected override void OnInitialized()
    {
        // Keeps the top-bar selector in step with the Skins page (and with any other change).
        Skins.Changed += OnSkinsChanged;
        Languages.Changed += OnLanguagesChanged;
        L.Changed += OnLanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Once per page load, after the first render, so the saved skin and language are in place from the start.
        if (_skinApplied) return;
        _skinApplied = true;
        await L.InitializeAsync();
        await Skins.ApplyAsync(await Skins.GetActiveAsync());
        await RefreshSkinListAsync();
        await RefreshLanguageListAsync();
    }

    private void OnLanguageChanged() => _ = InvokeAsync(() =>
    {
        _langVersion++;
        StateHasChanged();
    });

    private void OnLanguagesChanged() => _ = InvokeAsync(RefreshLanguageListAsync);

    private async Task RefreshLanguageListAsync()
    {
        var custom = await Languages.GetCustomAsync();
        _languageItems = LanguageCatalog.BuiltIn.Select(l => new TopBarMenuItem(l.Code, l.Name))
            .Concat(custom.Select(l => new TopBarMenuItem(l.Code, l.Name))).ToList();
        StateHasChanged();
    }

    private async Task OnLanguageSelected(string code)
    {
        if (string.Equals(code, L.CurrentCode, StringComparison.OrdinalIgnoreCase)) return;
        await L.SetCurrentAsync(code);
    }

    private void OnSkinsChanged() => _ = InvokeAsync(RefreshSkinListAsync);

    private async Task RefreshSkinListAsync()
    {
        var custom = await Skins.GetCustomAsync();
        _skinNames = SkinCatalog.BuiltIn.Select(s => s.Name).Concat(custom.Select(s => s.Name)).ToList();
        _skinItems = _skinNames.Select(n => new TopBarMenuItem(n, n)).ToList();
        _activeSkinName = await Skins.GetActiveNameAsync() ?? SkinCatalog.DefaultName;
        if (!_skinNames.Contains(_activeSkinName)) _activeSkinName = SkinCatalog.DefaultName;
        StateHasChanged();
    }

    private async Task OnSkinSelected(string name)
    {
        if (name == _activeSkinName) return;
        var skin = await Skins.FindAsync(name);
        if (skin is null) return;

        _activeSkinName = name;
        await Skins.SetActiveNameAsync(name);
        await Skins.ApplyAsync(skin);
    }

    public void Dispose()
    {
        Skins.Changed -= OnSkinsChanged;
        Languages.Changed -= OnLanguagesChanged;
        L.Changed -= OnLanguageChanged;
    }
}
