@inherits LayoutComponentBase

<RadzenComponents />

<div class="page @(_navCollapsed ? "nav-collapsed" : null)">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <button class="nav-toggle" @onclick="ToggleNav" title="Toggle menu" aria-label="Toggle menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
            <NavLink href="/quick-start"><span class="top-link-icon" aria-hidden="true"><RadzenIcon Icon="rocket_launch" /></span><span>Quick Start</span></NavLink>
            @* open_in_new rather than an "info" glyph: this link leaves the app for GitHub. *@
            <a href="https://github.com/gianpaoloi/AlyCE_LogAnalyzer" target="_blank"><span class="top-link-icon" aria-hidden="true"><RadzenIcon Icon="open_in_new" /></span><span>About</span></a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool _navCollapsed;
    private void ToggleNav() => _navCollapsed = !_navCollapsed;
}
