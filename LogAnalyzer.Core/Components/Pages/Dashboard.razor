@page "/dashboard"
@inject LogStore Store
@inherits ObservingComponentBase
@implements IDisposable

<PageTitle>Dashboard · AlyCE Log Analyzer</PageTitle>

<RadzenText TextStyle="TextStyle.H4">Dashboard</RadzenText>
<LoadPanel />

@if (Store.IsLoading)
{
    <div class="load-busy-block"><LoadProgress /></div>
}
else if (!Store.IsLoaded)
{
    <RadzenText class="rz-color-muted">Load a log folder to see charts.</RadzenText>
}
else
{
    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <RadzenText TextStyle="TextStyle.H6">Log volume @_bucketLabel (stacked by level)</RadzenText>
        @if (_hours.Count == 0)
        {
            <RadzenText class="rz-color-muted">No timestamped entries.</RadzenText>
        }
        else
        {
            <RadzenChart>
                <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Debug" Title="Debug" Fill="@ChartColors.Level("DEBUG")" />
                <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Info" Title="Info" Fill="@ChartColors.Level("INFO")" />
                <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Warn" Title="Warn" Fill="@ChartColors.Level("WARN")" />
                <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Error" Title="Error" Fill="@ChartColors.Level("ERROR")" />
                <RadzenCategoryAxis Padding="10" />
                <RadzenValueAxis><RadzenAxisTitle Text="entries" /></RadzenValueAxis>
                <RadzenLegend Position="LegendPosition.Bottom" />
            </RadzenChart>
        }
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <RadzenText TextStyle="TextStyle.H6">Errors &amp; warnings per hour</RadzenText>
        @{
            var problem = _hours.Where(h => h.Problem > 0).ToList();
        }
        @if (problem.Count == 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
                No errors or warnings in range 🎉
            </RadzenAlert>
        }
        else
        {
            <RadzenChart>
                <RadzenColumnSeries Data="@problem" CategoryProperty="Label" ValueProperty="Warn" Title="Warn" Fill="@ChartColors.Level("WARN")" />
                <RadzenColumnSeries Data="@problem" CategoryProperty="Label" ValueProperty="Error" Title="Error" Fill="@ChartColors.Level("ERROR")" />
                <RadzenCategoryAxis Padding="10" />
                <RadzenLegend Position="LegendPosition.Bottom" />
            </RadzenChart>
        }
    </RadzenCard>

    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenText TextStyle="TextStyle.H6">By level</RadzenText>
                <RadzenChart>
                    <RadzenPieSeries Data="@_levelData" CategoryProperty="Label" ValueProperty="Value" Fills="@_levelColors" />
                    <RadzenLegend Position="LegendPosition.Right" />
                </RadzenChart>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenText TextStyle="TextStyle.H6">Top loggers</RadzenText>
                <RadzenChart>
                    <RadzenBarSeries Data="@_loggerData" CategoryProperty="Label" ValueProperty="Value" />
                </RadzenChart>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
}

@code {
    private record HourRow(string Label, int Debug, int Info, int Warn, int Error)
    {
        public int Problem => Warn + Error;
    }
    private record ChartPoint(string Label, double Value);

    /// <summary>
    /// Most columns to hand a chart. The stats timeline is fixed hourly buckets over the whole
    /// span, so a month of logs was 720 SVG columns and a year was 8 760 — enough to lock the
    /// browser up. Past this, whole hours are grouped together (the Explorer's volume chart does
    /// the same thing with its own adaptive step).
    /// </summary>
    private const int MaxBars = 180;

    private List<HourRow> _hours = new();
    private string _bucketLabel = "per hour";
    private List<ChartPoint> _levelData = new();
    private string[] _levelColors = Array.Empty<string>();
    private List<ChartPoint> _loggerData = new();

    protected override void OnInitialized()
    {
        Store.DatasetChanged += OnChanged;
        if (Store.IsLoaded) Build();
    }

    private void Build()
    {
        var s = Store.Stats!;
        BuildTimeline(s.Timeline);

        var levels = s.ByLevel.OrderByDescending(kv => kv.Value).ToList();
        _levelData = levels.Select(kv => new ChartPoint(kv.Key, kv.Value)).ToList();
        _levelColors = levels.Select(kv => ChartColors.Level(kv.Key)).ToArray();

        _loggerData = s.ByLogger.OrderByDescending(kv => kv.Value).Take(15)
            .Select(kv => new ChartPoint(kv.Key, kv.Value)).ToList();
    }

    /// <summary>Groups the hourly buckets into at most <see cref="MaxBars"/> columns.</summary>
    private void BuildTimeline(List<TimeBucket> timeline)
    {
        if (timeline.Count == 0)
        {
            _hours = new List<HourRow>();
            _bucketLabel = "per hour";
            return;
        }

        // Grouped by elapsed time rather than by list position, because the timeline only holds
        // the hours that actually have entries — grouping by index would give columns of
        // different widths.
        var origin = timeline[0].Start;
        var spanHours = (timeline[^1].Start - origin).TotalHours + 1;
        var hoursPerBar = Math.Max(1, (int)Math.Ceiling(spanHours / MaxBars));
        _bucketLabel = Describe(hoursPerBar);

        var rows = new List<HourRow>(Math.Min(timeline.Count, MaxBars + 1));
        var bucketStart = origin;
        int debug = 0, info = 0, warn = 0, error = 0;
        var any = false;

        void Flush()
        {
            if (!any) return;
            rows.Add(new HourRow(Label(bucketStart, hoursPerBar), debug, info, warn, error));
            debug = info = warn = error = 0;
            any = false;
        }

        foreach (var b in timeline)
        {
            var index = (int)((b.Start - origin).TotalHours / hoursPerBar);
            var start = origin.AddHours((long)index * hoursPerBar);
            if (any && start != bucketStart) Flush();

            bucketStart = start;
            debug += b.Debug;
            info += b.Info;
            warn += b.Warn;
            error += b.Error;
            any = true;
        }

        Flush();
        _hours = rows;
    }

    private static string Label(DateTime start, int hoursPerBar) =>
        hoursPerBar >= 24 ? start.ToString("MM-dd") : start.ToString("MM-dd HH:00");

    private static string Describe(int hoursPerBar) => hoursPerBar switch
    {
        1 => "per hour",
        < 24 => $"per {hoursPerBar} hours",
        24 => "per day",
        _ => $"per {hoursPerBar / 24} days",
    };

    private void OnChanged() => RequestRefresh(() => { if (Store.IsLoaded) Build(); });
    public void Dispose() => Store.DatasetChanged -= OnChanged;
}
