@page "/explorer"
@inject LogStore Store
@inject AiSettingsStore AiStore
@inject AiUsageStore UsageStore
@inject DialogService DialogService
@inject SessionState State
@inject IJSRuntime JS
@inherits ObservingComponentBase
@implements IDisposable
@inject Localizer L

<PageTitle>@L["explorer.title"] · AlyCE Log Analyzer</PageTitle>

<RadzenText TextStyle="TextStyle.H4">@L["explorer.title"]</RadzenText>
<LoadPanel />

@* Until the first lines arrive only the progress shows; after that the lines streamed so far are shown while the load runs. *@
@if (Store.IsLoading && !Store.IsLoaded)
{
    <div class="load-busy-block"><LoadProgress /></div>
}
else if (!Store.IsLoaded)
{
    <RadzenText class="rz-color-muted">@L["explorer.loadPrompt"]</RadzenText>
}
else
{
    @if (Store.IsLoading)
    {
        <div class="load-busy-block"><LoadProgress /></div>
    }
    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.6rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="State.ExplorerText" @bind-Value:after="Apply" Placeholder="@(L["explorer.searchMessage"])" style="min-width:220px" />
            <RadzenTextBox @bind-Value="State.ExplorerLogger" @bind-Value:after="Apply" Placeholder="@(L["explorer.loggerContains"])" style="min-width:200px" />
            <RadzenButton Text="@(L["explorer.search"])" Icon="search" Click="Apply" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton Text="@(L["explorer.reset"])" Icon="clear" Click="Reset" ButtonStyle="ButtonStyle.Light" />
            <RadzenSplitButton Text="@(L["explorer.download"])" Icon="download" Click="OnDownload" ButtonStyle="ButtonStyle.Success"
                               Disabled="@(_filtered.Count == 0)">
                <ChildContent>
                    <RadzenSplitButtonItem Text="CSV (.csv)" Value="csv" />
                    <RadzenSplitButtonItem Text="@(L["explorer.logLines"])" Value="json" />
                </ChildContent>
            </RadzenSplitButton>
            <RadzenButton Icon="account_tree" Text="@(State.ExplorerShowLoggers ? L["explorer.hideLoggers"] : L["explorer.loggers"])"
                          Click="@(() => State.ExplorerShowLoggers = !State.ExplorerShowLoggers)" ButtonStyle="ButtonStyle.Secondary" />
            <RadzenDropDown @bind-Value="State.ExplorerColumns" Multiple="true" AllowClear="true" Chips="true"
                            Placeholder="@(L["explorer.addColumns"])" Data="@LogColumns.Optional"
                            TextProperty="Title" ValueProperty="Key" TValue="IEnumerable<string>" Style="width:300px" />
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-muted">@L["explorer.filterHint"]</RadzenText>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <RadzenStack Gap="0.5rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.6rem" Wrap="FlexWrap.Wrap">
                <RadzenTextBox @bind-Value="_question" Placeholder="@(L["ai.query.placeholder"])" style="flex:1; min-width:320px"
                               title="@(L["ai.query.hint"])" />
                <AiReviewToggle />
                <RadzenButton Text="@(L["ai.query.button"])" Icon="auto_awesome" ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small" Click="RunQuestion" Disabled="@(!_aiReady)" />
                @if (State.ExplorerRange is not null)
                {
                    <RadzenButton Text="@(L["ai.window.spike"])" Icon="show_chart" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" Click="@(() => StartWindow(WindowMode.Spike))" Disabled="@(!_aiReady)" />
                    <RadzenButton Text="@(L["ai.window.incident"])" Icon="summarize" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" Click="@(() => StartWindow(WindowMode.Incident))" Disabled="@(!_aiReady)" />
                }
            </RadzenStack>
            @if (!_aiReady)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-muted">@L["ai.notConfigured"]</RadzenText>
            }
            @if (_windowAsk is not null)
            {
                <AiContextConfirm Message="@WindowAskText()" OnProceed="@(() => ProceedWindow())" OnCancel="@(() => CancelWindowAsk())" />
            }
            @if (_query is not null)
            {
                <AiExplainPanel Settings="@_query.Settings" Preview="@_query.Preview" Result="@_query.Result" Response="@_query.Response"
                                Error="@_query.Error" Busy="@_query.Busy"
                                OnSend="@(text => SendQuestion(text))" OnCancel="@(() => CloseQuestion())" />
            }
            @if (_windowAnalysis is not null)
            {
                <AiExplainPanel Settings="@_windowAnalysis.Settings" Preview="@_windowAnalysis.Preview" Result="@_windowAnalysis.Result" Response="@_windowAnalysis.Response"
                                Error="@_windowAnalysis.Error" Busy="@_windowAnalysis.Busy"
                                OnSend="@(text => SendWindow(text))" OnCancel="@(() => CloseWindow())" />
            }
        </RadzenStack>
    </RadzenCard>

    <div class="side-layout">
        <div class="side-main">
            @* Fed the set filtered by everything except the time window, so the whole timeline
               stays on screen and the selection can be widened or moved. *@
            <LogVolumeChart Entries="@_chartSource" @bind-Collapsed="State.ExplorerVolumeCollapsed"
                            Range="@State.ExplorerRange" RangeChanged="OnRangeChanged"
                            ActiveLevels="@State.ExplorerLevels" LevelToggled="OnLevelToggled"
                            SelectedTime="@_selectedTime" />

            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-2">@L["explorer.entries", _filtered.Count.ToString("N0")]</RadzenText>

            <RadzenDataGrid @ref="_grid" Data="@_filtered" TItem="LogEntry" AllowPaging="true" PageSize="50"
                            AllowSorting="true"
                            Density="Density.Compact" PagerHorizontalAlign="HorizontalAlign.Center"
                            RowSelect="OpenDetail" AllowColumnResize="true"
                            PageSizeOptions="@(new[]{25,50,100,200})" ShowPagingSummary="true">
                <Columns>
                    @* Every filter lives in its column header, so they all sit on one line; Radzen's own
                       filter row put Time and Message on a second one. The time filter is the same window
                       the volume chart selects, so either one moves the other. *@
                    <RadzenDataGridColumn TItem="LogEntry" Title="@(L["explorer.colTime"])" Width="200px" Property="Time" SortOrder="SortOrder.Descending">
                        <HeaderTemplate>
                            <div class="col-filter">
                                <span class="col-filter-title">@L["explorer.colTime"]</span>
                                <TimeRangeFilter Range="@State.ExplorerRange" RangeChanged="OnRangeChanged"
                                                 FirstTime="@Store.Stats?.FirstTime" LastTime="@Store.Stats?.LastTime"
                                                 Tooltip="@(L["explorer.timeTooltip"])" />
                            </div>
                        </HeaderTemplate>
                        <Template Context="e"><span class="mono">@e.Time.ToString("MM-dd HH:mm:ss.fff")</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LogEntry" Title="@(L["explorer.colLevel"])" Width="200px" Property="Level" Filterable="false">
                        <HeaderTemplate>
                            <div class="col-filter">
                                <span class="col-filter-title">@L["explorer.colLevel"]</span>
                                <RadzenDropDown @bind-Value="State.ExplorerLevels" @bind-Value:after="Apply"
                                                Multiple="true" AllowClear="true" Chips="true"
                                                Placeholder="@(L["explorer.allLevels"])"Data="@_levels" TValue="IEnumerable<string>"
                                                Style="width:100%" />
                            </div>
                        </HeaderTemplate>
                        <Template Context="e"><LevelBadge Level="@e.Level" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LogEntry" Title="@(L["explorer.colEnvironment"])" Property="Environment" Width="240px" Filterable="false">
                        <HeaderTemplate>
                            <div class="col-filter">
                                <span class="col-filter-title">@L["explorer.colEnvironment"]</span>
                                <RadzenDropDown @bind-Value="State.ExplorerEnvironments" @bind-Value:after="Apply"
                                                Multiple="true" AllowClear="true" Chips="true"
                                                Placeholder="@(L["explorer.allEnvironments"])"Data="@_envs" TValue="IEnumerable<string>"
                                                Style="width:100%" />
                            </div>
                        </HeaderTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LogEntry" Title="@(L["explorer.colCompany"])" Property="Company" Width="220px" Filterable="false">
                        <HeaderTemplate>
                            <div class="col-filter">
                                <span class="col-filter-title">@L["explorer.colCompany"]</span>
                                <RadzenDropDown @bind-Value="State.ExplorerCompanies" @bind-Value:after="Apply"
                                                Multiple="true" AllowClear="true" Chips="true"
                                                Placeholder="@(L["explorer.allCompanies"])"Data="@_companies" TValue="IEnumerable<string>"
                                                Style="width:100%" />
                            </div>
                        </HeaderTemplate>
                        <Template Context="e"><span class="mono">@e.Company</span></Template>
                    </RadzenDataGridColumn>
                    @foreach (var col in LogColumns.Optional.Where(c => State.ExplorerColumns.Contains(c.Key)))
                    {
                        <RadzenDataGridColumn TItem="LogEntry" Title="@col.Title" Width="@col.Width" Filterable="false" Sortable="false">
                            <Template Context="e"><span class="mono">@col.Value(e)</span></Template>
                        </RadzenDataGridColumn>
                    }
                    <RadzenDataGridColumn TItem="LogEntry" Title="@(L["explorer.colMessage"])" Property="Message" Sortable="false">
                        <HeaderTemplate>
                            <div class="col-filter">
                                <span class="col-filter-title">@L["explorer.colMessage"]</span>
                                <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                    <RadzenTextBox @bind-Value="State.ExplorerMessage" @bind-Value:after="Apply"
                                                   Placeholder="@(L["explorer.messageContains"])" Style="width:100%" />
                                </div>
                            </div>
                        </HeaderTemplate>
                        <Template Context="e">
                            @e.ShortMessage
                            @if (e.HasStackTrace)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@(L["explorer.stack"])" class="rz-ml-1" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
        @if (State.ExplorerShowLoggers)
        {
            <div class="side-panel">
                <RadzenCard Variant="Variant.Outlined">
                    <LoggerTree Loggers="@Store.Stats!.ByLogger" Selected="@State.ExplorerLoggerPrefix" SelectedChanged="OnLoggerSelected" />
                </RadzenCard>
            </div>
        }
    </div>
}

@code {
    private RadzenDataGrid<LogEntry>? _grid;

    /// <summary>Rows matching every filter except the chart's time window — what the chart plots.</summary>
    private List<LogEntry> _chartSource = new();

    /// <summary><see cref="_chartSource"/> narrowed to the selected time window — what the grid shows.</summary>
    private List<LogEntry> _filtered = new();

    /// <summary>Timestamp of the last row opened, marked on the volume chart so the reader can place
    /// it in context even after the detail dialog closes.</summary>
    private DateTime? _selectedTime;

    // Cached distinct values for the header combos. Stable references so the
    // RadzenDropDown keeps its selection state across grid re-renders.
    private IReadOnlyList<string> _levels = Array.Empty<string>();
    private IReadOnlyList<string> _envs = Array.Empty<string>();
    private IReadOnlyList<string> _companies = Array.Empty<string>();

    protected override void OnInitialized()
    {
        Store.DatasetChanged += OnChanged;
        if (Store.IsLoaded) { RefreshDistincts(); Apply(); }
    }

    private void RefreshDistincts()
    {
        _levels = Store.DistinctLevels();
        _envs = Store.DistinctEnvironments();
        _companies = Store.DistinctCompanies();
    }

    private LogFilter BuildFilter()
    {
        var f = new LogFilter { Text = State.ExplorerText, Logger = State.ExplorerLogger, LoggerPrefix = State.ExplorerLoggerPrefix };
        foreach (var l in State.ExplorerLevels) f.Levels.Add(l);
        foreach (var ev in State.ExplorerEnvironments) f.Environments.Add(ev);
        foreach (var co in State.ExplorerCompanies) f.Companies.Add(co);
        return f;
    }

    private void OnLoggerSelected(string? prefix)
    {
        State.ExplorerLoggerPrefix = prefix;
        Apply();
    }

    private void Apply()
    {
        if (!Store.IsLoaded) return;
        var query = Store.Query(BuildFilter());
        // The header's message box narrows on top of the toolbar search, as the grid's own
        // message filter used to.
        var message = State.ExplorerMessage;
        if (!string.IsNullOrWhiteSpace(message))
            query = query.Where(e => e.Message.Contains(message, StringComparison.OrdinalIgnoreCase));
        _chartSource = query.ToList();
        ApplyRange();
    }

    /// <summary>Slices the already-filtered rows by the chart's window — no second full query.</summary>
    private void ApplyRange() =>
        _filtered = State.ExplorerRange is { } r
            ? _chartSource.Where(e => r.Contains(e.Time)).ToList()
            : _chartSource;

    private string _question = "";
    private AiPanelState? _query;
    private AiPanelState? _windowAnalysis;
    private WindowMode? _windowAsk;
    private bool _aiReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Browser storage is reachable only once the component is interactive.
        if (!firstRender) return;
        _aiReady = await AiStore.HasUsableProviderAsync();
        StateHasChanged();
    }

    /// <summary>Previews the request for a plain-language question. The filter changes only after the answer is read back.</summary>
    private async Task StartQuestion()
    {
        if (string.IsNullOrWhiteSpace(_question)) return;
        var question = _question;
        var levels = _levels.ToList();
        var environments = Store.DistinctEnvironments().ToList();
        var loggers = Store.DistinctLoggers().Take(AiFeatures.MaxFacetValues).ToList();

        var settings = (await AiStore.GetActiveAsync())?.Settings;
        _query = AiPanelState.Prepare(settings, L["ai.notConfigured"],
            () => AiFeatures.BuildQueryPreview(question, levels, environments, loggers, L.CurrentCode));
    }

    private async Task SendQuestion(string text)
    {
        if (_query is null) return;
        var sending = _query.SendAsync(UsageStore, text);
        StateHasChanged();
        await sending;

        if (_query.Result is { } reply)
        {
            try
            {
                var query = AiFeatures.ParseQuery(reply, _levels.ToList(), Store.DistinctEnvironments().ToList());
                ApplyQuery(query);
                _query.Result = L["ai.query.applied", query.Describe()];
            }
            catch (AiException e)
            {
                _query.Result = null;
                _query.Error = e.Message;
            }
        }
        StateHasChanged();
    }

    /// <summary>With Review off, the question is sent as soon as its request is built.</summary>
    private async Task RunQuestion()
    {
        await StartQuestion();
        if (!State.AiReview && _query?.Preview is { } preview) await SendQuestion(preview.User);
    }

    /// <summary>With Review off, a window analysis is sent as soon as it is built.</summary>
    private async Task AutoSendWindowAsync()
    {
        if (!State.AiReview && _windowAnalysis?.Preview is { } preview) await SendWindow(preview.User);
    }

    private void CloseQuestion() => _query = null;

    /// <summary>Sets the toolbar filters from the answer. Only names that exist in the loaded file were kept by the parser.</summary>
    private void ApplyQuery(AiQuery query)
    {
        State.ExplorerLevels = query.Levels.ToList();
        State.ExplorerEnvironments = query.Environment is null ? Array.Empty<string>() : new[] { query.Environment };
        State.ExplorerText = query.Text;
        State.ExplorerLogger = query.Logger;
        State.ExplorerLoggerPrefix = null;

        if (query.From is not null || query.To is not null)
        {
            var first = Store.Stats?.FirstTime ?? DateTime.MinValue;
            var last = Store.Stats?.LastTime ?? DateTime.MaxValue;
            State.ExplorerRange = new TimeRange(query.From ?? first, query.To ?? last);
        }
        Apply();
    }

    /// <summary>Previews the spike or incident analysis of the selected time window.</summary>
    private async Task StartWindow(WindowMode mode)
    {
        if (State.ExplorerRange is not { } range) return;

        // A large window gets a confirmation first; the preview is built only after the user agrees.
        var length = range.To - range.From;
        var baselineCount = mode == WindowMode.Spike ? _chartSource.Count(e => e.Time >= range.From - length && e.Time < range.From) : 0;
        if (AiFeatures.IsLargeContext(_filtered.Count + baselineCount))
        {
            _windowAsk = mode;
            _windowAnalysis = null;
            return;
        }
        await PrepareWindow(mode);
        await AutoSendWindowAsync();
    }

    private async Task ProceedWindow()
    {
        if (_windowAsk is not { } mode) return;
        _windowAsk = null;
        await PrepareWindow(mode);
        await AutoSendWindowAsync();
        StateHasChanged();
    }

    private void CancelWindowAsk() => _windowAsk = null;

    /// <summary>What the confirmation tells the user before a large window is sent.</summary>
    private string WindowAskText()
    {
        if (State.ExplorerRange is not { } range) return "";
        var length = range.To - range.From;
        var baseline = _windowAsk == WindowMode.Spike
            ? _chartSource.Count(e => e.Time >= range.From - length && e.Time < range.From)
            : 0;
        return L["ai.large.window", (_filtered.Count).ToString("N0"), baseline.ToString("N0"), range.ToString()];
    }

    private async Task PrepareWindow(WindowMode mode)
    {
        if (State.ExplorerRange is not { } range) return;
        var settings = (await AiStore.GetActiveAsync())?.Settings;
        _windowAnalysis = AiPanelState.Prepare(settings, L["ai.notConfigured"], () =>
        {
            // The window is the filtered rows inside the range. The baseline is the same length just before it.
            var window = _filtered;
            var length = range.To - range.From;
            var baseline = mode == WindowMode.Spike
                ? _chartSource.Where(e => e.Time >= range.From - length && e.Time < range.From).ToList()
                : new List<LogEntry>();
            return AiFeatures.BuildWindowPreview(mode, window, baseline, L.CurrentCode);
        });
    }

    private async Task SendWindow(string text)
    {
        if (_windowAnalysis is null) return;
        var sending = _windowAnalysis.SendAsync(UsageStore, text);
        StateHasChanged();
        await sending;
        StateHasChanged();
    }

    private void CloseWindow() => _windowAnalysis = null;

    private void OnRangeChanged(TimeRange? range)
    {
        State.ExplorerRange = range;
        ApplyRange();
    }

    // A legend click filters on every raw level that maps to the clicked series (so "warn"
    // covers WARN and WARNING); clicking it again with all of them selected clears them.
    private void OnLevelToggled(string seriesKey)
    {
        var matching = _levels.Where(l => LogVolumeChart.SeriesKey(l) == seriesKey).ToList();
        if (matching.Count == 0) return;

        var selected = State.ExplorerLevels.ToList();
        if (matching.All(selected.Contains))
            selected.RemoveAll(matching.Contains);
        else
            selected.AddRange(matching.Except(selected));

        State.ExplorerLevels = selected;
        Apply();
    }

    private void Reset()
    {
        State.ExplorerLevels = new List<string>();
        State.ExplorerEnvironments = new List<string>();
        State.ExplorerCompanies = new List<string>();
        State.ExplorerText = State.ExplorerMessage = State.ExplorerLogger = State.ExplorerLoggerPrefix = null;
        State.ExplorerRange = null;
        Apply();
    }

    // Main button (null item) defaults to CSV; the menu chooses the format explicitly.
    private async Task OnDownload(RadzenSplitButtonItem? item)
    {
        var json = item?.Value == "json";
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        var name = json ? $"explorer-logs-{stamp}.log" : $"explorer-logs-{stamp}.csv";

        // Written to a self-deleting temp file rather than built up in memory: a large filtered set
        // used to exist as a StringBuilder, a string and a byte array all at once.
        await using var stream = await LogExport.OpenExportAsync(_filtered, json);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", name, streamRef);
    }

    private async Task OpenDetail(LogEntry e)
    {
        _selectedTime = e.Time;
        await DialogService.OpenAsync<LogDetail>(
            $"{e.Level} · {e.Time:HH:mm:ss.fff}",
            new Dictionary<string, object?> { { "Entry", e }, { "Correlate", true } },
            new DialogOptions { Width = "900px", Height = "auto", Resizable = true, Draggable = true });
    }

    private void OnChanged() => RequestRefresh(() => { RefreshDistincts(); Apply(); });
    public void Dispose() => Store.DatasetChanged -= OnChanged;
}
