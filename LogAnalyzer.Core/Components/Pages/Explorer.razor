@page "/explorer"
@inject LogStore Store
@inject DialogService DialogService
@inject SessionState State
@inject IJSRuntime JS
@inherits ObservingComponentBase
@implements IDisposable

<PageTitle>Explorer · AlyCE Log Analyzer</PageTitle>

<RadzenText TextStyle="TextStyle.H4">Explorer</RadzenText>
<LoadPanel />

@if (Store.IsLoading)
{
    <div class="load-busy-block"><LoadProgress /></div>
}
else if (!Store.IsLoaded)
{
    <RadzenText class="rz-color-muted">Load a log folder to search entries.</RadzenText>
}
else
{
    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.6rem" Wrap="FlexWrap.Wrap">
            <RadzenTextBox @bind-Value="State.ExplorerText" @bind-Value:after="Apply" Placeholder="search message…" style="min-width:220px" />
            <RadzenTextBox @bind-Value="State.ExplorerLogger" @bind-Value:after="Apply" Placeholder="logger contains…" style="min-width:200px" />
            <RadzenButton Text="Search" Icon="search" Click="Apply" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton Text="Reset" Icon="clear" Click="Reset" ButtonStyle="ButtonStyle.Light" />
            <RadzenSplitButton Text="Download" Icon="download" Click="OnDownload" ButtonStyle="ButtonStyle.Success"
                               Disabled="@(_filtered.Count == 0)">
                <ChildContent>
                    <RadzenSplitButtonItem Text="CSV (.csv)" Value="csv" />
                    <RadzenSplitButtonItem Text="Log lines (.log)" Value="json" />
                </ChildContent>
            </RadzenSplitButton>
            <RadzenButton Icon="account_tree" Text="@(State.ExplorerShowLoggers ? "Hide loggers" : "Loggers")"
                          Click="@(() => State.ExplorerShowLoggers = !State.ExplorerShowLoggers)" ButtonStyle="ButtonStyle.Secondary" />
            <RadzenDropDown @bind-Value="State.ExplorerColumns" Multiple="true" AllowClear="true" Chips="true"
                            Placeholder="Add columns…" Data="@LogColumns.Optional"
                            TextProperty="Title" ValueProperty="Key" TValue="IEnumerable<string>" Style="width:300px" />
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-muted">Filter Level / Environment / Time / Message from the column headers</RadzenText>
        </RadzenStack>
    </RadzenCard>

    <div class="side-layout">
        <div class="side-main">
            @* Fed the set filtered by everything except the time window, so the whole timeline
               stays on screen and the selection can be widened or moved. *@
            <LogVolumeChart Entries="@_chartSource" @bind-Collapsed="State.ExplorerVolumeCollapsed"
                            Range="@State.ExplorerRange" RangeChanged="OnRangeChanged"
                            ActiveLevels="@State.ExplorerLevels" LevelToggled="OnLevelToggled" />

            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-2">@_filtered.Count.ToString("N0") entries — sort or use the per-column filter icons to refine; click a row for detail</RadzenText>

            <RadzenDataGrid @ref="_grid" Data="@_filtered" TItem="LogEntry" AllowPaging="true" PageSize="50"
                            AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Density="Density.Compact" PagerHorizontalAlign="HorizontalAlign.Center"
                            RowSelect="OpenDetail" AllowColumnResize="true"
                            PageSizeOptions="@(new[]{25,50,100,200})" ShowPagingSummary="true">
                <Columns>
                    <RadzenDataGridColumn TItem="LogEntry" Title="Time" Width="165px" Property="Time" SortOrder="SortOrder.Descending">
                        <Template Context="e"><span class="mono">@e.Time.ToString("MM-dd HH:mm:ss.fff")</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LogEntry" Title="Level" Width="200px" Property="Level" Filterable="false">
                        <HeaderTemplate>
                            <div class="col-filter">
                                <span class="col-filter-title">Level</span>
                                <RadzenDropDown @bind-Value="State.ExplorerLevels" @bind-Value:after="Apply"
                                                Multiple="true" AllowClear="true" Chips="true"
                                                Placeholder="All levels" Data="@_levels" TValue="IEnumerable<string>"
                                                Style="width:100%" />
                            </div>
                        </HeaderTemplate>
                        <Template Context="e"><LevelBadge Level="@e.Level" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LogEntry" Title="Environment" Property="Environment" Width="240px" Filterable="false">
                        <HeaderTemplate>
                            <div class="col-filter">
                                <span class="col-filter-title">Environment</span>
                                <RadzenDropDown @bind-Value="State.ExplorerEnvironments" @bind-Value:after="Apply"
                                                Multiple="true" AllowClear="true" Chips="true"
                                                Placeholder="All environments" Data="@_envs" TValue="IEnumerable<string>"
                                                Style="width:100%" />
                            </div>
                        </HeaderTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LogEntry" Title="Company" Property="Company" Width="220px" Filterable="false">
                        <HeaderTemplate>
                            <div class="col-filter">
                                <span class="col-filter-title">Company</span>
                                <RadzenDropDown @bind-Value="State.ExplorerCompanies" @bind-Value:after="Apply"
                                                Multiple="true" AllowClear="true" Chips="true"
                                                Placeholder="All companies" Data="@_companies" TValue="IEnumerable<string>"
                                                Style="width:100%" />
                            </div>
                        </HeaderTemplate>
                        <Template Context="e"><span class="mono">@e.Company</span></Template>
                    </RadzenDataGridColumn>
                    @foreach (var col in LogColumns.Optional.Where(c => State.ExplorerColumns.Contains(c.Key)))
                    {
                        <RadzenDataGridColumn TItem="LogEntry" Title="@col.Title" Width="@col.Width" Filterable="false" Sortable="false">
                            <Template Context="e"><span class="mono">@col.Value(e)</span></Template>
                        </RadzenDataGridColumn>
                    }
                    <RadzenDataGridColumn TItem="LogEntry" Title="Message" Property="Message" Sortable="false">
                        <Template Context="e">
                            @e.ShortMessage
                            @if (e.HasStackTrace)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="stack" class="rz-ml-1" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
        @if (State.ExplorerShowLoggers)
        {
            <div class="side-panel">
                <RadzenCard Variant="Variant.Outlined">
                    <LoggerTree Loggers="@Store.Stats!.ByLogger" Selected="@State.ExplorerLoggerPrefix" SelectedChanged="OnLoggerSelected" />
                </RadzenCard>
            </div>
        }
    </div>
}

@code {
    private RadzenDataGrid<LogEntry>? _grid;

    /// <summary>Rows matching every filter except the chart's time window — what the chart plots.</summary>
    private List<LogEntry> _chartSource = new();

    /// <summary><see cref="_chartSource"/> narrowed to the selected time window — what the grid shows.</summary>
    private List<LogEntry> _filtered = new();

    // Cached distinct values for the header combos. Stable references so the
    // RadzenDropDown keeps its selection state across grid re-renders.
    private IReadOnlyList<string> _levels = Array.Empty<string>();
    private IReadOnlyList<string> _envs = Array.Empty<string>();
    private IReadOnlyList<string> _companies = Array.Empty<string>();

    protected override void OnInitialized()
    {
        Store.DatasetChanged += OnChanged;
        if (Store.IsLoaded) { RefreshDistincts(); Apply(); }
    }

    private void RefreshDistincts()
    {
        _levels = Store.DistinctLevels();
        _envs = Store.DistinctEnvironments();
        _companies = Store.DistinctCompanies();
    }

    private LogFilter BuildFilter()
    {
        var f = new LogFilter { Text = State.ExplorerText, Logger = State.ExplorerLogger, LoggerPrefix = State.ExplorerLoggerPrefix };
        foreach (var l in State.ExplorerLevels) f.Levels.Add(l);
        foreach (var ev in State.ExplorerEnvironments) f.Environments.Add(ev);
        foreach (var co in State.ExplorerCompanies) f.Companies.Add(co);
        return f;
    }

    private void OnLoggerSelected(string? prefix)
    {
        State.ExplorerLoggerPrefix = prefix;
        Apply();
    }

    private void Apply()
    {
        if (!Store.IsLoaded) return;
        _chartSource = Store.Query(BuildFilter()).ToList();
        ApplyRange();
    }

    /// <summary>Slices the already-filtered rows by the chart's window — no second full query.</summary>
    private void ApplyRange() =>
        _filtered = State.ExplorerRange is { } r
            ? _chartSource.Where(e => r.Contains(e.Time)).ToList()
            : _chartSource;

    private void OnRangeChanged(TimeRange? range)
    {
        State.ExplorerRange = range;
        ApplyRange();
    }

    // A legend click filters on every raw level that maps to the clicked series (so "warn"
    // covers WARN and WARNING); clicking it again with all of them selected clears them.
    private void OnLevelToggled(string seriesKey)
    {
        var matching = _levels.Where(l => LogVolumeChart.SeriesKey(l) == seriesKey).ToList();
        if (matching.Count == 0) return;

        var selected = State.ExplorerLevels.ToList();
        if (matching.All(selected.Contains))
            selected.RemoveAll(matching.Contains);
        else
            selected.AddRange(matching.Except(selected));

        State.ExplorerLevels = selected;
        Apply();
    }

    private void Reset()
    {
        State.ExplorerLevels = new List<string>();
        State.ExplorerEnvironments = new List<string>();
        State.ExplorerCompanies = new List<string>();
        State.ExplorerText = State.ExplorerLogger = State.ExplorerLoggerPrefix = null;
        State.ExplorerRange = null;
        Apply();
    }

    // Main button (null item) defaults to CSV; the menu chooses the format explicitly.
    private async Task OnDownload(RadzenSplitButtonItem? item)
    {
        var json = item?.Value == "json";
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        var name = json ? $"explorer-logs-{stamp}.log" : $"explorer-logs-{stamp}.csv";

        // Written to a self-deleting temp file rather than built up in memory: a large filtered set
        // used to exist as a StringBuilder, a string and a byte array all at once.
        await using var stream = await LogExport.OpenExportAsync(_filtered, json);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", name, streamRef);
    }

    private async Task OpenDetail(LogEntry e)
    {
        await DialogService.OpenAsync<LogDetail>(
            $"{e.Level} · {e.Time:HH:mm:ss.fff}",
            new Dictionary<string, object?> { { "Entry", e } },
            new DialogOptions { Width = "900px", Height = "auto", Resizable = true, Draggable = true });
    }

    private void OnChanged() => RequestRefresh(() => { RefreshDistincts(); Apply(); });
    public void Dispose() => Store.DatasetChanged -= OnChanged;
}
