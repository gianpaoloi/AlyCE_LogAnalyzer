@page "/"
@inject LogStore Store
@inherits ObservingComponentBase
@implements IDisposable

<PageTitle>Overview · AlyCE Log Analyzer</PageTitle>

<RadzenText TextStyle="TextStyle.H4">Overview</RadzenText>
<LoadPanel />

@if (Store.IsLoading)
{
    <div class="load-busy-block"><LoadProgress /></div>
}
else if (!Store.IsLoaded)
{
    <RadzenText class="rz-color-muted">Point the box above at a folder of <code>*.log</code> files and press <b>Load</b> or click on the Drop box to select <b>logs files</b> or <b>zip file</b>.</RadzenText>
}
else
{
    var s = Store.Stats!;
    <RadzenRow Gap="1rem" class="rz-mb-3">
        <RadzenColumn Size="6" SizeMD="2">@StatCard("Entries", s.TotalEntries, null)</RadzenColumn>
        <RadzenColumn Size="6" SizeMD="2">@StatCard("Files", s.FileCount, null)</RadzenColumn>
        <RadzenColumn Size="6" SizeMD="2">@StatCard("Environments", s.ByEnvironment.Count, null)</RadzenColumn>
        <RadzenColumn Size="6" SizeMD="2">@StatCard("Loggers", s.ByLogger.Count, null)</RadzenColumn>
        <RadzenColumn Size="6" SizeMD="2">@StatCard("Errors", ErrorCount, ErrorCount > 0 ? "rz-background-color-danger-light" : null)</RadzenColumn>
        <RadzenColumn Size="6" SizeMD="2">@StatCard("Warnings", WarnCount, WarnCount > 0 ? "rz-background-color-warning-light" : null)</RadzenColumn>
    </RadzenRow>

    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <b>Time span:</b> @Fmt(s.FirstTime) &rarr; @Fmt(s.LastTime)
        @if (s.Span is { } sp)
        {
            <span class="rz-color-muted"> (@FormatSpan(sp))</span>
        }
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <RadzenText TextStyle="TextStyle.H6">Log volume @_bucketLabel (stacked by level)</RadzenText>
        @if (_hours.Count == 0)
        {
            <RadzenText class="rz-color-muted">No timestamped entries.</RadzenText>
        }
        else
        {
            <RadzenChart>
                <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Debug" Title="Debug" Fill="@ChartColors.Level("DEBUG")" />
                <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Info" Title="Info" Fill="@ChartColors.Level("INFO")" />
                <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Warn" Title="Warn" Fill="@ChartColors.Level("WARN")" />
                <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Error" Title="Error" Fill="@ChartColors.Level("ERROR")" />
                @if (_hasOther)
                {
                    <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Other" Title="Other" Fill="@ChartColors.Level("OTHER")" />
                }
                <RadzenCategoryAxis Padding="10" />
                <RadzenValueAxis><RadzenAxisTitle Text="entries" /></RadzenValueAxis>
                <RadzenLegend Position="LegendPosition.Bottom" />
            </RadzenChart>
        }
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <RadzenText TextStyle="TextStyle.H6">Errors &amp; warnings @_bucketLabel</RadzenText>
        @if (_problemHours.Count == 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
                No errors or warnings in range 🎉
            </RadzenAlert>
        }
        else
        {
            <RadzenChart>
                <RadzenColumnSeries Data="@_problemHours" CategoryProperty="Label" ValueProperty="Warn" Title="Warn" Fill="@ChartColors.Level("WARN")" />
                <RadzenColumnSeries Data="@_problemHours" CategoryProperty="Label" ValueProperty="Error" Title="Error" Fill="@ChartColors.Level("ERROR")" />
                <RadzenCategoryAxis Padding="10" />
                <RadzenLegend Position="LegendPosition.Bottom" />
            </RadzenChart>
        }
    </RadzenCard>

    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenText TextStyle="TextStyle.H6">By level</RadzenText>
                <RadzenChart>
                    <RadzenPieSeries Data="@_levelData" CategoryProperty="Label" ValueProperty="Value" Fills="@_levelColors" />
                    <RadzenLegend Position="LegendPosition.Right" />
                </RadzenChart>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenText TextStyle="TextStyle.H6">Top environments</RadzenText>
                <RadzenChart>
                    <RadzenBarSeries Data="@_envData" CategoryProperty="Label" ValueProperty="Value" />
                </RadzenChart>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Variant="Variant.Outlined" class="rz-mt-3">
        <RadzenText TextStyle="TextStyle.H6">Top loggers</RadzenText>
        <RadzenChart>
            <RadzenBarSeries Data="@_loggerData" CategoryProperty="Label" ValueProperty="Value" />
        </RadzenChart>
    </RadzenCard>
}

@code {
    private record ChartPoint(string Label, double Value);

    private record HourRow(string Label, int Debug, int Info, int Warn, int Error, int Other)
    {
        public int Problem => Warn + Error;
    }

    /// <summary>
    /// Most columns to hand a chart; past this <see cref="TimelineView.Downsample"/> groups whole
    /// hours together. The Explorer's volume chart does the same thing with its own adaptive step.
    /// </summary>
    private const int MaxBars = 180;

    private List<HourRow> _hours = new();
    private List<HourRow> _problemHours = new();
    private string _bucketLabel = "per hour";
    private bool _hasOther;
    private List<ChartPoint> _levelData = new();
    private string[] _levelColors = Array.Empty<string>();
    private List<ChartPoint> _envData = new();
    private List<ChartPoint> _loggerData = new();

    private int ErrorCount => Get("ERROR") + Get("FATAL");
    private int WarnCount => Get("WARN") + Get("WARNING");
    private int Get(string level) => Store.Stats!.ByLevel.TryGetValue(level, out var n) ? n : 0;

    protected override void OnInitialized()
    {
        Store.DatasetChanged += OnChanged;
        if (Store.IsLoaded) Build();
    }

    private void Build()
    {
        var s = Store.Stats!;
        BuildTimeline(s.Timeline);

        var levels = s.ByLevel.OrderByDescending(kv => kv.Value).ToList();
        _levelData = levels.Select(kv => new ChartPoint(kv.Key, kv.Value)).ToList();
        _levelColors = levels.Select(kv => ChartColors.Level(kv.Key)).ToArray();
        _envData = s.ByEnvironment.OrderByDescending(kv => kv.Value).Take(10)
            .Select(kv => new ChartPoint(kv.Key, kv.Value)).ToList();
        _loggerData = s.ByLogger.OrderByDescending(kv => kv.Value).Take(15)
            .Select(kv => new ChartPoint(kv.Key, kv.Value)).ToList();
    }

    private void BuildTimeline(List<TimeBucket> timeline)
    {
        var view = TimelineView.Downsample(timeline, MaxBars);
        _bucketLabel = view.Describe();

        _hours = view.Buckets
            .Select(b => new HourRow(view.Label(b), b.Debug, b.Info, b.Warn, b.Error, b.Other))
            .ToList();

        // Precomputed rather than filtered in the markup, so it isn't redone on every render.
        _problemHours = _hours.Where(h => h.Problem > 0).ToList();
        // The series is only worth a legend entry when the log has levels outside the four.
        _hasOther = _hours.Any(h => h.Other > 0);
    }

    private RenderFragment StatCard(string label, int value, string? cssClass) => __builder =>
    {
        <RadzenCard Variant="Variant.Outlined" class="@($"rz-text-align-center {cssClass}")">
            <RadzenText TextStyle="TextStyle.H4" class="rz-mb-0">@value.ToString("N0")</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption">@label</RadzenText>
        </RadzenCard>
    };

    private void OnChanged() => RequestRefresh(() => { if (Store.IsLoaded) Build(); });
    public void Dispose() => Store.DatasetChanged -= OnChanged;

    private static string Fmt(DateTime? d) => d is { } x ? x.ToString("yyyy-MM-dd HH:mm:ss") : "—";
    private static string FormatSpan(TimeSpan t) =>
        t.TotalDays >= 1 ? $"{t.TotalDays:0.#} d" : t.TotalHours >= 1 ? $"{t.TotalHours:0.#} h" : $"{t.TotalMinutes:0.#} min";
}
