@page "/"
@inject Localizer L
@inject LogStore Store
@inject AiSettingsStore AiStore
@inject AiUsageStore UsageStore
@inject SessionState Session
@inherits ObservingComponentBase
@implements IDisposable

<PageTitle>@L["home.title"] · AlyCE Log Analyzer</PageTitle>

<RadzenText TextStyle="TextStyle.H4">@L["home.title"]</RadzenText>
<LoadPanel />

@* Until the first lines arrive only the progress shows; after that the lines streamed so far are shown while the load runs. *@
@if (Store.IsLoading && !Store.IsLoaded)
{
    <div class="load-busy-block"><LoadProgress /></div>
}
else if (!Store.IsLoaded)
{
    <RadzenText class="rz-color-muted">@((MarkupString)L["home.emptyIntro"])</RadzenText>
}
else
{
    @if (Store.IsLoading)
    {
        <div class="load-busy-block"><LoadProgress /></div>
    }
    var s = Store.Stats!;
    <RadzenRow Gap="1rem" class="rz-mb-3">
        <RadzenColumn Size="6" SizeMD="2">@StatCard(L["home.entries"], s.TotalEntries, null)</RadzenColumn>
        <RadzenColumn Size="6" SizeMD="2">@StatCard(L["home.files"], s.FileCount, null)</RadzenColumn>
        <RadzenColumn Size="6" SizeMD="2">@StatCard(L["home.environments"], s.ByEnvironment.Count, null)</RadzenColumn>
        <RadzenColumn Size="6" SizeMD="2">@StatCard(L["home.loggers"], s.ByLogger.Count, null)</RadzenColumn>
        <RadzenColumn Size="6" SizeMD="2">@StatCard(L["home.errors"], ErrorCount, ErrorCount > 0 ? "rz-background-color-danger-light" : null)</RadzenColumn>
        <RadzenColumn Size="6" SizeMD="2">@StatCard(L["home.warnings"], WarnCount, WarnCount > 0 ? "rz-background-color-warning-light" : null)</RadzenColumn>
    </RadzenRow>

    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <b>@L["home.timeSpan"]</b> @Fmt(s.FirstTime) &rarr; @Fmt(s.LastTime)
        @if (s.Span is { } sp)
        {
            <span class="rz-color-muted"> (@FormatSpan(sp))</span>
        }
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <RadzenText TextStyle="TextStyle.H6">@L["ai.overview.title"]</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-muted">@L["ai.overview.hint"]</RadzenText>
        <AiReviewToggle />
        <RadzenButton Text="@(L["ai.overview.button"])" Icon="auto_awesome" ButtonStyle="ButtonStyle.Primary"
                      Size="ButtonSize.Small" Click="StartOverview" Disabled="@(!_aiReady)" />
        @if (!_aiReady)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-muted rz-mt-1">@L["ai.notConfigured"]</RadzenText>
        }
        @if (_overviewAsk)
        {
            <div class="rz-mt-2">
                <AiContextConfirm Message="@L["ai.large.overview", Store.Stats!.TotalEntries.ToString("N0"), Fmt(Store.Stats.FirstTime), Fmt(Store.Stats.LastTime)]"
                                  OnProceed="@(() => ProceedOverview())" OnCancel="@(() => CancelOverviewAsk())" />
            </div>
        }
        @if (_overview is not null)
        {
            <div class="rz-mt-2">
                <AiExplainPanel Settings="@_overview.Settings" Preview="@_overview.Preview" Result="@_overview.Result" Response="@_overview.Response"
                                Error="@_overview.Error" Busy="@_overview.Busy"
                                OnSend="@(text => SendOverview(text))" OnCancel="@(() => CloseOverview())" />
            </div>
        }
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <RadzenText TextStyle="TextStyle.H6">@L["home.logVolume", _bucketLabel]</RadzenText>
        @if (_hours.Count == 0)
        {
            <RadzenText class="rz-color-muted">@L["home.noTimestamps"]</RadzenText>
        }
        else
        {
            <RadzenChart>
                <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Debug" Title="Debug" Fill="@ChartColors.Level("DEBUG")" />
                <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Info" Title="Info" Fill="@ChartColors.Level("INFO")" />
                <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Warn" Title="Warn" Fill="@ChartColors.Level("WARN")" />
                <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Error" Title="Error" Fill="@ChartColors.Level("ERROR")" />
                @if (_hasOther)
                {
                    <RadzenStackedColumnSeries Data="@_hours" CategoryProperty="Label" ValueProperty="Other" Title="@(L["home.other"])" Fill="@ChartColors.Level("OTHER")" />
                }
                <RadzenCategoryAxis Padding="10" />
                <RadzenValueAxis><RadzenAxisTitle Text="@(L["home.entriesAxis"])" /></RadzenValueAxis>
                <RadzenLegend Position="LegendPosition.Bottom" />
            </RadzenChart>
        }
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <RadzenText TextStyle="TextStyle.H6">@L["home.problemVolume", _bucketLabel]</RadzenText>
        @if (_problemHours.Count == 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
                @L["home.noProblems"]
            </RadzenAlert>
        }
        else
        {
            <RadzenChart>
                <RadzenColumnSeries Data="@_problemHours" CategoryProperty="Label" ValueProperty="Warn" Title="Warn" Fill="@ChartColors.Level("WARN")" />
                <RadzenColumnSeries Data="@_problemHours" CategoryProperty="Label" ValueProperty="Error" Title="Error" Fill="@ChartColors.Level("ERROR")" />
                <RadzenCategoryAxis Padding="10" />
                <RadzenLegend Position="LegendPosition.Bottom" />
            </RadzenChart>
        }
    </RadzenCard>

    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenText TextStyle="TextStyle.H6">@L["home.byLevel"]</RadzenText>
                <RadzenChart>
                    <RadzenPieSeries Data="@_levelData" CategoryProperty="Label" ValueProperty="Value" Fills="@_levelColors" />
                    <RadzenLegend Position="LegendPosition.Right" />
                </RadzenChart>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenCard Variant="Variant.Outlined">
                <RadzenText TextStyle="TextStyle.H6">@L["home.topEnvironments"]</RadzenText>
                <RadzenChart>
                    <RadzenBarSeries Data="@_envData" CategoryProperty="Label" ValueProperty="Value" />
                </RadzenChart>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Variant="Variant.Outlined" class="rz-mt-3">
        <RadzenText TextStyle="TextStyle.H6">@L["home.topLoggers"]</RadzenText>
        <RadzenChart>
            <RadzenBarSeries Data="@_loggerData" CategoryProperty="Label" ValueProperty="Value" />
        </RadzenChart>
    </RadzenCard>
}

@code {
    private record ChartPoint(string Label, double Value);

    private AiPanelState? _overview;
    private bool _overviewAsk;
    private bool _aiReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Browser storage is reachable only once the component is interactive.
        if (!firstRender) return;
        _aiReady = await AiStore.HasUsableProviderAsync();
        StateHasChanged();
    }

    /// <summary>Previews the overview request. Nothing leaves the machine until Send is pressed.</summary>
    private async Task StartOverview()
    {
        // A large file gets a confirmation first; the preview is built only after the user agrees.
        if (AiFeatures.IsLargeContext(Store.Stats!.TotalEntries))
        {
            _overviewAsk = true;
            _overview = null;
            return;
        }
        await PrepareOverview();
        if (!Session.AiReview && _overview?.Preview is { } overviewPreview) await SendOverview(overviewPreview.User);
    }

    private async Task ProceedOverview()
    {
        _overviewAsk = false;
        await PrepareOverview();
        if (!Session.AiReview && _overview?.Preview is { } overviewPreview) await SendOverview(overviewPreview.User);
        StateHasChanged();
    }

    private void CancelOverviewAsk() => _overviewAsk = false;

    private async Task PrepareOverview()
    {
        var settings = (await AiStore.GetActiveAsync())?.Settings;
        _overview = AiPanelState.Prepare(settings, L["ai.notConfigured"], () =>
        {
            var problems = Store.Triage(new[] { "ERROR", "FATAL", "WARN", "WARNING" }, null);
            return AiFeatures.BuildOverviewPreview(Store.Stats!, problems, L.CurrentCode);
        });
    }

    private void CloseOverview() => _overview = null;

    private async Task SendOverview(string text)
    {
        if (_overview is null) return;
        // SendAsync marks the panel busy before its first await, so render once it has started.
        var sending = _overview.SendAsync(UsageStore, text);
        StateHasChanged();
        await sending;
        StateHasChanged();
    }

    private record HourRow(string Label, int Debug, int Info, int Warn, int Error, int Other)
    {
        public int Problem => Warn + Error;
    }

    /// <summary>
    /// Most columns to hand a chart; past this <see cref="TimelineView.Downsample"/> groups whole
    /// hours together. The Explorer's volume chart does the same thing with its own adaptive step.
    /// </summary>
    private const int MaxBars = 180;

    private List<HourRow> _hours = new();
    private List<HourRow> _problemHours = new();
    private string _bucketLabel = "per hour";
    private bool _hasOther;
    private List<ChartPoint> _levelData = new();
    private string[] _levelColors = Array.Empty<string>();
    private List<ChartPoint> _envData = new();
    private List<ChartPoint> _loggerData = new();

    private int ErrorCount => Get("ERROR") + Get("FATAL");
    private int WarnCount => Get("WARN") + Get("WARNING");
    private int Get(string level) => Store.Stats!.ByLevel.TryGetValue(level, out var n) ? n : 0;

    protected override void OnInitialized()
    {
        Store.DatasetChanged += OnChanged;
        if (Store.IsLoaded) Build();
    }

    private void Build()
    {
        var s = Store.Stats!;
        BuildTimeline(s.Timeline);

        var levels = s.ByLevel.OrderByDescending(kv => kv.Value).ToList();
        _levelData = levels.Select(kv => new ChartPoint(kv.Key, kv.Value)).ToList();
        _levelColors = levels.Select(kv => ChartColors.Level(kv.Key)).ToArray();
        _envData = s.ByEnvironment.OrderByDescending(kv => kv.Value).Take(10)
            .Select(kv => new ChartPoint(kv.Key, kv.Value)).ToList();
        _loggerData = s.ByLogger.OrderByDescending(kv => kv.Value).Take(15)
            .Select(kv => new ChartPoint(kv.Key, kv.Value)).ToList();
    }

    private void BuildTimeline(List<TimeBucket> timeline)
    {
        var view = TimelineView.Downsample(timeline, MaxBars);
        _bucketLabel = view.Describe();

        _hours = view.Buckets
            .Select(b => new HourRow(view.Label(b), b.Debug, b.Info, b.Warn, b.Error, b.Other))
            .ToList();

        // Precomputed rather than filtered in the markup, so it isn't redone on every render.
        _problemHours = _hours.Where(h => h.Problem > 0).ToList();
        // The series is only worth a legend entry when the log has levels outside the four.
        _hasOther = _hours.Any(h => h.Other > 0);
    }

    private RenderFragment StatCard(string label, int value, string? cssClass) => __builder =>
    {
        <RadzenCard Variant="Variant.Outlined" class="@($"rz-text-align-center {cssClass}")">
            <RadzenText TextStyle="TextStyle.H4" class="rz-mb-0">@value.ToString("N0")</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption">@label</RadzenText>
        </RadzenCard>
    };

    private void OnChanged() => RequestRefresh(() => { if (Store.IsLoaded) Build(); });
    public void Dispose() => Store.DatasetChanged -= OnChanged;

    private static string Fmt(DateTime? d) => d is { } x ? x.ToString("yyyy-MM-dd HH:mm:ss") : "—";
    private string FormatSpan(TimeSpan t) =>
        t.TotalDays >= 1 ? L["home.spanDays", t.TotalDays.ToString("0.#")]
        : t.TotalHours >= 1 ? L["home.spanHours", t.TotalHours.ToString("0.#")]
        : L["home.spanMinutes", t.TotalMinutes.ToString("0.#")];
}
