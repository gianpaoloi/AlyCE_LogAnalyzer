@page "/quick-start"

<PageTitle>Quick Start · AlyCE Log Analyzer</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-3">Quick Start</RadzenText>

@if (_loadError is not null)
{
  <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" class="rz-mb-3">
    @_loadError
  </RadzenAlert>
}
else
{
  <RadzenCard Variant="Variant.Outlined" class="quick-start-card">
    <div class="quick-start-content">@_quickStartText</div>
  </RadzenCard>
}

@code {
  private string _quickStartText = string.Empty;
  private string? _loadError;

  protected override void OnInitialized()
  {
    try
    {
      var quickStartPath = Path.Combine(AppContext.BaseDirectory, "README-HOW-TO.txt");
      _quickStartText = File.ReadAllText(quickStartPath);
    }
    catch (Exception ex)
    {
      _loadError = $"Unable to load quick start information from README-HOW-TO.txt: {ex.Message}";
    }
  }
}

<style>
    .quick-start-card {
        max-width: 72rem;
    }

    .quick-start-content {
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.95rem;
        line-height: 1.55;
        white-space: pre-wrap;
        word-break: break-word;
    }
</style>