@page "/triage"
@inject LogStore Store
@inject IJSRuntime JS
@inherits ObservingComponentBase
@implements IDisposable
@inject Localizer L

<PageTitle>@L["triage.pageTitle"] · AlyCE Log Analyzer</PageTitle>

<RadzenText TextStyle="TextStyle.H4">@L["triage.title"]</RadzenText>
<LoadPanel />

@* Until the first lines arrive only the progress shows; after that the lines streamed so far are shown while the load runs. *@
@if (Store.IsLoading && !Store.IsLoaded)
{
    <div class="load-busy-block"><LoadProgress /></div>
}
else if (!Store.IsLoaded)
{
    <RadzenText class="rz-color-muted">@L["triage.loadPrompt"]</RadzenText>
}
else
{
    @if (Store.IsLoading)
    {
        <div class="load-busy-block"><LoadProgress /></div>
    }
    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
            <RadzenCheckBox @bind-Value="_showError" @bind-Value:after="Recompute" Name="err" />
            <RadzenLabel Text="@(L["triage.errors"])" Component="err" />
            <RadzenCheckBox @bind-Value="_showWarn" @bind-Value:after="Recompute" Name="wrn" />
            <RadzenLabel Text="@(L["triage.warnings"])" Component="wrn" />
            <RadzenDropDown @bind-Value="_env" @bind-Value:after="Recompute" Data="@Store.DistinctEnvironments()" TValue="string"
                            AllowClear="true" Placeholder="@(L["triage.allEnvironments"])" style="min-width:220px" />
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-2">
        @(L["triage.summary", _groups.Count.ToString("N0"), _groups.Sum(g => g.Count).ToString("N0")])
    </RadzenText>

    <RadzenDataGrid Data="@_groups" TItem="MessageGroup" AllowPaging="true" PageSize="25"
                    AllowSorting="true" Density="Density.Compact" ExpandMode="DataGridExpandMode.Single">
        <Template Context="g">
            <RadzenStack Gap="0.5rem" class="rz-p-2">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Wrap="FlexWrap.Wrap">
                    <span><b>@L["triage.first"]</b> @g.FirstSeen.ToString("yyyy-MM-dd HH:mm:ss")</span>
                    <span><b>@L["triage.last"]</b> @g.LastSeen.ToString("yyyy-MM-dd HH:mm:ss")</span>
                    <span><b>@L["triage.environments"]</b> @(g.Environments.Count == 0 ? "—" : string.Join(", ", g.Environments))</span>
                </RadzenStack>
                <span><b>@L["triage.loggers"]</b> @(g.Loggers.Count == 0 ? "—" : string.Join(", ", g.Loggers))</span>
                @if (g.Sample is not null)
                {
                    <pre class="detail-message">@g.Sample.PrettyMessage</pre>
                }
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="@(L["triage.copyMessage"])" Icon="content_copy" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@(() => CopyToClipboard(g.SampleMessage))" />
                    <RadzenButton Text="@(L["triage.copyDetails"])" Icon="content_copy" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@(() => CopyToClipboard(BuildDetails(g)))" />
                </RadzenStack>
            </RadzenStack>
        </Template>
        <Columns>
            <RadzenDataGridColumn TItem="MessageGroup" Title="@(L["triage.colCount"])" Property="Count" Width="90px" TextAlign="TextAlign.Right" />
            <RadzenDataGridColumn TItem="MessageGroup" Title="@(L["triage.colLevel"])" Property="Level" Width="95px">
                <Template Context="g"><LevelBadge Level="@g.Level" /></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MessageGroup" Title="@(L["triage.colSample"])" Property="SampleMessage" Sortable="false" />
            <RadzenDataGridColumn TItem="MessageGroup" Title="@(L["triage.colLastSeen"])" Property="LastSeen" Width="170px">
                <Template Context="g"><span class="mono">@g.LastSeen.ToString("MM-dd HH:mm:ss")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MessageGroup" Title="@(L["triage.colEnvs"])" Width="70px" TextAlign="TextAlign.Right" Sortable="false">
                <Template Context="g">@g.Environments.Count</Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    private bool _showError = true;
    private bool _showWarn = true;
    private string? _env;
    private IReadOnlyList<MessageGroup> _groups = Array.Empty<MessageGroup>();

    protected override void OnInitialized()
    {
        Store.DatasetChanged += OnChanged;
        if (Store.IsLoaded) Recompute();
    }

    private void Recompute()
    {
        if (!Store.IsLoaded) { _groups = Array.Empty<MessageGroup>(); return; }
        var levels = new List<string>();
        if (_showError) { levels.Add("ERROR"); levels.Add("FATAL"); }
        if (_showWarn) { levels.Add("WARN"); levels.Add("WARNING"); }
        _groups = Store.Triage(levels, _env);
    }

    private void OnChanged() => RequestRefresh(Recompute);
    public void Dispose() => Store.DatasetChanged -= OnChanged;

    private async Task CopyToClipboard(string? text)
    {
        if (!string.IsNullOrEmpty(text))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

    private static string BuildDetails(MessageGroup g)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Level:        {g.Level}");
        sb.AppendLine($"Count:        {g.Count}");
        sb.AppendLine($"First seen:   {g.FirstSeen:yyyy-MM-dd HH:mm:ss}");
        sb.AppendLine($"Last seen:    {g.LastSeen:yyyy-MM-dd HH:mm:ss}");
        if (g.Environments.Count > 0)
            sb.AppendLine($"Environments: {string.Join(", ", g.Environments)}");
        if (g.Loggers.Count > 0)
            sb.AppendLine($"Loggers:      {string.Join(", ", g.Loggers)}");
        if (g.Sample is not null)
            sb.AppendLine($"Message:\n{g.Sample.PrettyMessage}");
        return sb.ToString().TrimEnd();
    }
}
