@page "/triage"
@inject LogStore Store
@inject IJSRuntime JS
@inject AiSettingsStore AiStore
@inject AiUsageStore UsageStore
@inject SessionState Session
@inject DialogService DialogService
@inject UpdateChecker Updates
@inherits ObservingComponentBase
@implements IDisposable
@inject Localizer L

<PageTitle>@L["triage.pageTitle"] · AlyCE Log Analyzer</PageTitle>

<RadzenText TextStyle="TextStyle.H4">@L["triage.title"]</RadzenText>
<LoadPanel />

@* Until the first lines arrive only the progress shows; after that the lines streamed so far are shown while the load runs. *@
@if (Store.IsLoading && !Store.IsLoaded)
{
    <div class="load-busy-block"><LoadProgress /></div>
}
else if (!Store.IsLoaded)
{
    <RadzenText class="rz-color-muted">@L["triage.loadPrompt"]</RadzenText>
}
else
{
    @if (Store.IsLoading)
    {
        <div class="load-busy-block"><LoadProgress /></div>
    }
    <RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
            <RadzenCheckBox @bind-Value="_showError" @bind-Value:after="Recompute" Name="err" />
            <RadzenLabel Text="@(L["triage.errors"])" Component="err" />
            <RadzenCheckBox @bind-Value="_showWarn" @bind-Value:after="Recompute" Name="wrn" />
            <RadzenLabel Text="@(L["triage.warnings"])" Component="wrn" />
            <RadzenDropDown @bind-Value="_env" @bind-Value:after="Recompute" Data="@Store.DistinctEnvironments()" TValue="string"
                            AllowClear="true" Placeholder="@(L["triage.allEnvironments"])" style="min-width:220px" />
            <RadzenButton Text="@(L["ai.triage.analyse"])" Icon="auto_awesome" ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small" Click="OpenAi" Disabled="@(!_aiReady)" />
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-2">
        @(L["triage.summary", _groups.Count.ToString("N0"), _groups.Sum(g => g.Count).ToString("N0")])
    </RadzenText>

    @if (_aiOpen)
    {
        <AiWindow Title="@L["ai.triage.analyse"]" OnClose="CloseAi">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <AiReviewToggle />
                <RadzenButton Text="@(L["ai.triage.analyse"])" Icon="auto_awesome" ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small" Click="RunTriageAnalysis" Disabled="@(!_aiReady)" />
                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-muted">
                    @(_aiReady ? L["ai.triage.hint"] : L["ai.notConfigured"])
                    @if (_aiReady && Session.AiReview)
                    {
                        <span>@L["ai.review.onNote"]</span>
                    }
                </RadzenText>
            </RadzenStack>
            @if (_explain.TryGetValue(TriageKey, out var triage))
            {
                <AiExplainPanel Settings="@triage.Settings" Preview="@triage.Preview" Result="@triage.Result" Response="@triage.Response"
                                Error="@triage.Error" Busy="@triage.Busy"
                                OnSend="@(text => SendExplain(TriageKey, text))"
                                OnCancel="@(() => CancelExplain(TriageKey))" />
            }
        </AiWindow>
    }

    <RadzenDataGrid Data="@_groups" TItem="MessageGroup" AllowPaging="true" PageSize="25"
                    AllowSorting="true" Density="Density.Compact" ExpandMode="DataGridExpandMode.Single">
        <Template Context="g">
            <RadzenStack Gap="0.5rem" class="rz-p-2">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Wrap="FlexWrap.Wrap">
                    <span><b>@L["triage.first"]</b> @g.FirstSeen.ToString("yyyy-MM-dd HH:mm:ss")</span>
                    <span><b>@L["triage.last"]</b> @g.LastSeen.ToString("yyyy-MM-dd HH:mm:ss")</span>
                    <span><b>@L["triage.environments"]</b> @(g.Environments.Count == 0 ? "—" : string.Join(", ", g.Environments))</span>
                </RadzenStack>
                <span><b>@L["triage.loggers"]</b> @(g.Loggers.Count == 0 ? "—" : string.Join(", ", g.Loggers))</span>
                @if (g.Sample is not null)
                {
                    <pre class="detail-message">@g.Sample.PrettyMessage</pre>
                }
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="@(L["triage.copyMessage"])" Icon="content_copy" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@(() => CopyToClipboard(g.SampleMessage))" />
                    <RadzenButton Text="@(L["triage.copyDetails"])" Icon="content_copy" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Click="@(() => CopyToClipboard(BuildDetails(g)))" />
                    <RadzenButton Text="@(L["ai.explain.button"])" Icon="auto_awesome" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" Disabled="@(!_aiReady)"
                                  Click="@(() => RunExplain(g))" />
                    <RadzenButton Text="@(L["ai.draft.button"])" Icon="bug_report" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" Disabled="@(!_aiReady)"
                                  Click="@(() => RunDraft(g))" />
                    <RadzenButton Text="@(L["triage.issueManual"])" Icon="bug_report" ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small" Click="@(() => OpenManualIssue(g))" />
                </RadzenStack>
                @if (_explain.TryGetValue(g.Signature, out var explain))
                {
                    <AiExplainPanel Settings="@explain.Settings" Preview="@explain.Preview" Result="@explain.Result" Response="@explain.Response"
                                    Error="@explain.Error" Busy="@explain.Busy"
                                    OnSend="@(text => SendExplain(g.Signature, text))"
                                    OnCancel="@(() => CancelExplain(g.Signature))" />
                }
                @if (_drafts.TryGetValue(g.Signature, out var draft))
                {
                    <div class="ai-draft">
                        @if (draft.Title is null)
                        {
                            <AiExplainPanel Settings="@draft.State.Settings" Preview="@draft.State.Preview" Result="@null"
                                            Error="@draft.State.Error" Busy="@draft.State.Busy"
                                            OnSend="@(text => SendDraft(g.Signature, text))"
                                            OnCancel="@(() => CancelDraft(g.Signature))" />
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-muted">@L["ai.draft.hint"]</RadzenText>
                            <RadzenTextBox @bind-Value="draft.Title" Placeholder="@(L["ai.draft.titleLabel"])" style="width:100%" />
                            <RadzenTextArea @bind-Value="draft.Body" Rows="10" style="width:100%" class="rz-mt-2" />
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mt-2">
                                <RadzenButton Text="@(L["ai.draft.open"])" ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Small" Click="@(() => OpenIssueDialog(draft.Title ?? "", draft.Body ?? ""))" />
                                <RadzenButton Text="@(L["ai.draft.discard"])" ButtonStyle="ButtonStyle.Light"
                                              Size="ButtonSize.Small" Click="@(() => CancelDraft(g.Signature))" />
                            </RadzenStack>
                        }
                    </div>
                }
            </RadzenStack>
        </Template>
        <Columns>
            <RadzenDataGridColumn TItem="MessageGroup" Title="@(L["triage.colCount"])" Property="Count" Width="90px" TextAlign="TextAlign.Right" />
            <RadzenDataGridColumn TItem="MessageGroup" Title="@(L["triage.colLevel"])" Property="Level" Width="95px">
                <Template Context="g"><LevelBadge Level="@g.Level" /></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MessageGroup" Title="@(L["triage.colSample"])" Property="SampleMessage" Sortable="false" />
            <RadzenDataGridColumn TItem="MessageGroup" Title="@(L["triage.colLastSeen"])" Property="LastSeen" Width="170px">
                <Template Context="g"><span class="mono">@g.LastSeen.ToString("MM-dd HH:mm:ss")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MessageGroup" Title="@(L["triage.colEnvs"])" Width="70px" TextAlign="TextAlign.Right" Sortable="false">
                <Template Context="g">@g.Environments.Count</Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    private bool _showError = true;
    private bool _showWarn = true;
    private string? _env;
    private IReadOnlyList<MessageGroup> _groups = Array.Empty<MessageGroup>();

    /// <summary>The explain panel of one cluster, keyed by its signature. Open panels stay open across a filter change.</summary>
    private sealed class ExplainState
    {
        public AiSettings? Settings { get; set; }
        public AiPreview? Preview { get; set; }
        public string? Result { get; set; }
        public string? Error { get; set; }
        public bool Busy { get; set; }
        public AiResponse? Response { get; set; }
    }

    private readonly Dictionary<string, ExplainState> _explain = new(StringComparer.Ordinal);

    /// <summary>Builds the preview the user reads before anything is sent. Nothing leaves the machine here.</summary>
    private async Task StartExplain(MessageGroup g)
    {
        var settings = (await AiStore.GetActiveAsync())?.Settings;
        var state = new ExplainState { Settings = settings };
        if (settings is null) state.Error = L["ai.notConfigured"];
        else if (settings.Validate() is { } problem) state.Error = problem;
        else state.Preview = AiAssistant.BuildClusterPreview(g, L.CurrentCode);

        _explain[g.Signature] = state;
    }

    /// <summary>Key of the whole-list analysis. It holds no "|", so it never collides with a cluster signature.</summary>
    private const string TriageKey = "*triage*";

    /// <summary>Previews one request that ranks the clusters currently shown. Nothing leaves the machine until Send.</summary>
    private async Task StartTriageAnalysis()
    {
        var settings = (await AiStore.GetActiveAsync())?.Settings;
        var state = new ExplainState { Settings = settings };
        if (settings is null) state.Error = L["ai.notConfigured"];
        else if (settings.Validate() is { } problem) state.Error = problem;
        else if (_groups.Count == 0) state.Error = L["ai.triage.empty"];
        else state.Preview = AiLogAnalysis.BuildTriagePreview(_groups, L.CurrentCode);

        _explain[TriageKey] = state;
    }

    /// <summary>With Review off, the explanation of a cluster is sent as soon as its request is built.</summary>
    private async Task RunExplain(MessageGroup g)
    {
        await StartExplain(g);
        if (!Session.AiReview && _explain.TryGetValue(g.Signature, out var state) && state.Preview is { } preview)
            await SendExplain(g.Signature, preview.User);
    }

    /// <summary>With Review off, the whole-list analysis is sent as soon as its request is built.</summary>
    private async Task RunTriageAnalysis()
    {
        await StartTriageAnalysis();
        if (!Session.AiReview && _explain.TryGetValue(TriageKey, out var state) && state.Preview is { } preview)
            await SendExplain(TriageKey, preview.User);
    }

    /// <summary>With Review off, a draft issue is requested as soon as its request is built.</summary>
    private async Task RunDraft(MessageGroup g)
    {
        await StartDraft(g);
        if (!Session.AiReview && _drafts.TryGetValue(g.Signature, out var draft) && draft.State.Preview is { } preview)
            await SendDraft(g.Signature, preview.User);
    }

    private void CancelExplain(string signature) => _explain.Remove(signature);

    /// <summary>A draft issue for one cluster: the request is previewed, then its title and body are shown to edit.</summary>
    private sealed class DraftState
    {
        public AiPanelState State { get; init; } = null!;
        public string? Title { get; set; }
        public string? Body { get; set; }
    }

    private readonly Dictionary<string, DraftState> _drafts = new(StringComparer.Ordinal);

    private bool _aiReady;
    private bool _aiOpen;

    private void OpenAi() => _aiOpen = true;

    /// <summary>Hides the AI window; the analysis stays until the next run.</summary>
    private void CloseAi() => _aiOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Browser storage is reachable only once the component is interactive.
        if (!firstRender) return;
        _aiReady = await AiStore.HasUsableProviderAsync();
        StateHasChanged();
    }

    /// <summary>Appended to every draft. The draft is written in English, so the footer is too.</summary>
    private const string DraftFooter =
        "---\nDrafted with AI from a log cluster in AlyCE Log Analyzer. Check the text against the log before you submit.";

    private async Task StartDraft(MessageGroup g)
    {
        var settings = (await AiStore.GetActiveAsync())?.Settings;
        _drafts[g.Signature] = new DraftState
        {
            State = AiPanelState.Prepare(settings, L["ai.notConfigured"], () => AiFeatures.BuildIssueDraftPreview(g)),
        };
    }

    private async Task SendDraft(string signature, string text)
    {
        if (!_drafts.TryGetValue(signature, out var draft)) return;

        var sending = draft.State.SendAsync(UsageStore, text);
        StateHasChanged();
        await sending;

        if (draft.State.Result is { } reply)
        {
            try
            {
                var parsed = AiFeatures.ParseIssueDraft(reply);
                draft.Title = parsed.Title;
                draft.Body = parsed.Body;
                draft.State.Result = null;
            }
            catch (AiException e)
            {
                draft.State.Result = null;
                draft.State.Error = e.Message;
            }
        }
        StateHasChanged();
    }

    private void CancelDraft(string signature) => _drafts.Remove(signature);

    /// <summary>Asks which repository the edited draft goes to, then opens its new-issue page. The user still presses Submit there.</summary>
    /// <summary>Opens a hand-written issue for one cluster, without AI: the title is the message, the body the details.</summary>
    private Task OpenManualIssue(MessageGroup g)
    {
        var message = (g.SampleMessage ?? "").ReplaceLineEndings(" ").Trim();
        var title = "[AlyCE] " + (message.Length > 80 ? message[..80] : message);
        return OpenIssueDialog(title, "Product: AlyCE\n\n" + BuildDetails(g));
    }

    private async Task OpenIssueDialog(string title, string body)
    {
        await DialogService.OpenAsync<GitHubIssueDialog>(L["ai.draft.open"],
            new Dictionary<string, object?>
            {
                { "Title", title },
                { "Body", body },
                { "Footer", DraftFooter },
                { "DefaultRepository", Updates.Options.Repository }
            },
            new DialogOptions { Width = "620px", Resizable = true, Draggable = true });
    }

    /// <summary>Sends the previewed text, once the user has pressed Send on it.</summary>
    private async Task SendExplain(string signature, string text)
    {
        if (!_explain.TryGetValue(signature, out var state) || state.Settings is null || state.Preview is null) return;

        state.Busy = true;
        state.Error = null;
        StateHasChanged();
        try
        {
            var response = await AiAssistant.SendAsync(state.Settings, state.Preview! with { User = text });
            state.Result = response.Text;
            state.Response = response;
            await UsageStore.RecordAsync(state.Settings.ProviderId, response);
        }
        catch (AiException e)
        {
            state.Error = e.Message;
        }
        finally
        {
            state.Busy = false;
        }
    }

    protected override void OnInitialized()
    {
        Store.DatasetChanged += OnChanged;
        if (Store.IsLoaded) Recompute();
    }

    private void Recompute()
    {
        if (!Store.IsLoaded) { _groups = Array.Empty<MessageGroup>(); return; }
        var levels = new List<string>();
        if (_showError) { levels.Add("ERROR"); levels.Add("FATAL"); }
        if (_showWarn) { levels.Add("WARN"); levels.Add("WARNING"); }
        _groups = Store.Triage(levels, _env);
    }

    private void OnChanged() => RequestRefresh(Recompute);
    public void Dispose() => Store.DatasetChanged -= OnChanged;

    private async Task CopyToClipboard(string? text)
    {
        if (!string.IsNullOrEmpty(text))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

    private static string BuildDetails(MessageGroup g)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Level:        {g.Level}");
        sb.AppendLine($"Count:        {g.Count}");
        sb.AppendLine($"First seen:   {g.FirstSeen:yyyy-MM-dd HH:mm:ss}");
        sb.AppendLine($"Last seen:    {g.LastSeen:yyyy-MM-dd HH:mm:ss}");
        if (g.Environments.Count > 0)
            sb.AppendLine($"Environments: {string.Join(", ", g.Environments)}");
        if (g.Loggers.Count > 0)
            sb.AppendLine($"Loggers:      {string.Join(", ", g.Loggers)}");
        if (g.Sample is not null)
            sb.AppendLine($"Message:\n{g.Sample.PrettyMessage}");
        return sb.ToString().TrimEnd();
    }
}
