@page "/feedback"
@inject Localizer L
@inject UpdateChecker Updates
@inject LogStore Store
@inject LogWatcher Watcher
@inject NetworkLogListener Listener

<PageTitle>@L["feedback.title"] · AlyCE Log Analyzer</PageTitle>

<RadzenText TextStyle="TextStyle.H4">@L["feedback.title"]</RadzenText>
<RadzenText TextStyle="TextStyle.Body2" class="rz-color-muted rz-mb-3">
    @L["feedback.intro"] <b>@L["feedback.submitNewIssue"]</b> @L["feedback.introEnd"]
</RadzenText>

<RadzenCard Variant="Variant.Outlined" class="feedback-card rz-mb-3">
    <RadzenStack Gap="0.75rem">
        <RadzenLabel Text="@(L["feedback.kindLabel"])" Component="kind" />
        <RadzenDropDown @bind-Value="_kind" Data="@_kinds" TextProperty="Text" ValueProperty="Value"
                        TValue="IssueKind" Name="kind" Style="max-width:320px" />

        <RadzenLabel Text="@(L["feedback.titleLabel"])" Component="title" />
        <RadzenTextBox @bind-Value="_title" Name="title" Immediate="true" MaxLength="@IssueLink.MaxTitleLength"
                       Placeholder="@_titlePlaceholder" />

        @if (_kind == IssueKind.Bug)
        {
            <RadzenLabel Text="@(L["feedback.pageLabel"])" Component="page" />
            <RadzenDropDown @bind-Value="_page" Data="@Pages" AllowClear="true" Name="page"
                            Placeholder="@(L["feedback.choosePage"])" Style="max-width:320px" />

            <RadzenLabel Text="@(L["feedback.inputLabel"])" Component="input" />
            <RadzenDropDown @bind-Value="_input" Data="@Inputs" AllowClear="true" Name="input"
                            Placeholder="@(L["feedback.chooseOne"])" Style="max-width:320px" />

            <RadzenLabel Text="@(L["feedback.stepsLabel"])" Component="steps" />
            <RadzenTextArea @bind-Value="_steps" Name="steps" Immediate="true" Rows="5" MaxLength="3000"
                            Placeholder="@(L["feedback.stepsPlaceholder"])" />

            <RadzenLabel Text="@(L["feedback.expectedLabel"])" Component="expected" />
            <RadzenTextArea @bind-Value="_expected" Name="expected" Immediate="true" Rows="2" MaxLength="1500" />

            <RadzenLabel Text="@(L["feedback.actualLabel"])" Component="actual" />
            <RadzenTextArea @bind-Value="_actual" Name="actual" Immediate="true" Rows="2" MaxLength="1500" />

            <RadzenLabel Text="@(L["feedback.frequencyLabel"])" Component="frequency" />
            <RadzenDropDown @bind-Value="_frequency" Data="@Frequencies" AllowClear="true" Name="frequency"
                            Placeholder="@(L["feedback.chooseOne"])" Style="max-width:320px" />
        }
        else
        {
            <RadzenLabel Text="@(L["feedback.detailsLabel"])" Component="details" />
            <RadzenTextArea @bind-Value="_details" Name="details" Immediate="true" Rows="8" MaxLength="4000"
                            Placeholder="@(L["feedback.detailsPlaceholder"])" />
        }

        <RadzenCheckBox @bind-Value="_includeEnvironment" Name="env" Immediate="true" />
        <RadzenLabel Text="@_environmentLabel" Component="env" />
        @if (_kind == IssueKind.Bug && _includeEnvironment)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-muted rz-m-0">
                @L["feedback.sentNote"]
            </RadzenText>
        }

        <RadzenCheckBox Value="_includeResources" TValue="bool" Name="resources" Change="OnResourcesToggled" />
        <RadzenLabel Text="@(L["feedback.resourcesLabel"])" Component="resources" />
        @if (_includeResources)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-muted rz-m-0">
                @(_resourcesText is null
                    ? L["feedback.measuring"]
                    : L["feedback.captured", _capturedAt.ToString("HH:mm:ss")])
            </RadzenText>
        }

        <div class="feedback-actions">
            @* An anchor rather than a button: the WebView hands a target="_blank" link to the system
               browser, which is how the About link leaves the app too. Without a title there is
               nothing to file, so the link is left without an href and the button goes inert. *@
            <a class="btn btn-primary @(_canSubmit ? null : "disabled")"
               href="@(_canSubmit ? _issueUrl : null)" target="_blank" rel="noopener noreferrer"
               aria-disabled="@(!_canSubmit)">
                <RadzenIcon Icon="open_in_new" /> @L["feedback.submitOnGitHub"]
            </a>
            @if (_canSubmit)
            {
                <a class="btn btn-outline-secondary" href="@_searchUrl" target="_blank" rel="noopener noreferrer">
                    <RadzenIcon Icon="travel_explore" /> @L["feedback.searchFirst"]
                </a>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-muted rz-m-0">@L["feedback.enterTitle"]</RadzenText>
            }
        </div>
    </RadzenStack>
</RadzenCard>

<RadzenCard Variant="Variant.Outlined" class="feedback-card">
    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2"><b>@L["feedback.checkTitle"]</b></RadzenText>
    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-muted rz-mb-2">
        @L["feedback.checkIntro"]
    </RadzenText>
    <div class="feedback-checklist">
        @foreach (var item in _kind == IssueKind.Bug ? _bugChecklist : _featureChecklist)
        {
            <label class="feedback-check">
                <RadzenCheckBox @bind-Value="item.Done" TValue="bool" />
                <span>@L[item.Key]</span>
            </label>
        }
    </div>
</RadzenCard>

@code {
    private sealed record KindOption(string Text, IssueKind Value);

    private sealed class CheckItem(string key)
    {
        public string Key { get; } = key;
        public bool Done { get; set; }
    }

    private IReadOnlyList<KindOption> _kinds =>
    [
        new(L["feedback.kindFeature"], IssueKind.Feature),
        new(L["feedback.kindBug"], IssueKind.Bug),
    ];

    private static readonly string[] Pages =
    [
        "Overview", "Explorer", "Triage", "File Live Watch", "Network Live Watch",
        "Quick Info", "Feedback", "Not sure",
    ];

    private static readonly string[] Inputs =
    [
        "A local log file", "A folder of log files", "A ZIP archive", "A live file being tailed",
        "Network Live Watch (UDP events)", "Lines pasted from the clipboard", "Not sure",
    ];

    private static readonly string[] Frequencies = ["Every time", "Sometimes", "Happened once"];

    // Rebuilt on each visit, so ticks do not survive leaving the page.
    private readonly List<CheckItem> _bugChecklist =
    [
        new("feedback.bugCheck1"),
        new("feedback.bugCheck2"),
        new("feedback.bugCheck3"),
        new("feedback.bugCheck4"),
        new("feedback.bugCheck5"),
        new("feedback.bugCheck6"),
        new("feedback.bugCheck7"),
    ];

    private readonly List<CheckItem> _featureChecklist =
    [
        new("feedback.featureCheck1"),
        new("feedback.featureCheck2"),
        new("feedback.featureCheck3"),
    ];

    private IssueKind _kind = IssueKind.Feature;
    private string? _title;
    private string? _details;
    private string? _page;
    private string? _input;
    private string? _steps;
    private string? _expected;
    private string? _actual;
    private string? _frequency;
    private bool _includeEnvironment = true;
    private bool _includeResources;
    private string? _resourcesText;
    private DateTime _capturedAt;

    private bool _canSubmit => !string.IsNullOrWhiteSpace(_title);

    /// <summary>Ticking the box measures the figures once; the link carries that reading.</summary>
    private async Task OnResourcesToggled(bool value)
    {
        _includeResources = value;
        _resourcesText = null;
        if (!value) return;

        _resourcesText = await CaptureResourcesAsync();
        _capturedAt = DateTime.Now;
        StateHasChanged();
    }

    private async Task<string> CaptureResourcesAsync()
    {
        // CPU figures need two readings, so take a baseline, wait a second and read again.
        using var sampler = new ResourceSampler();
        sampler.Sample();
        await Task.Delay(TimeSpan.FromSeconds(1));
        var snapshot = sampler.Sample(Store.LoadedPath);

        var input = ResourceReport.Input(ResourceSampler.ReadComputerInfo(), snapshot, Store, Watcher, Listener);
        return ResourceReport.ToMarkdown(ResourceReport.Panels(input, locations: false));
    }

    private string _environmentLabel => _kind == IssueKind.Bug
        ? L["feedback.envBug", AppVersion.Display]
        : L["feedback.envFeature", AppVersion.Display];

    private string _issueText => _kind == IssueKind.Bug
        ? IssueLink.BugBody(new BugSteps(_page, _steps, _expected, _actual, _frequency, _input))
        : _details ?? string.Empty;

    private string _titlePlaceholder => _kind == IssueKind.Bug
        ? L["feedback.bugTitlePlaceholder"]
        : L["feedback.featureTitlePlaceholder"];

    // A bug always carries the app version, even with the machine details unticked: without it no
    // maintainer can tell which build the report is about.
    private string _issueFooter
    {
        get
        {
            var footer = _kind == IssueKind.Bug
                ? IssueLink.Footer(MachineInfo.Describe(AppVersion.Full, includeMachine: _includeEnvironment))
                : (_includeEnvironment ? IssueLink.Footer($"AlyCE Log Analyzer {AppVersion.Full}") : string.Empty);

            if (_includeResources && _resourcesText is not null)
                footer += IssueLink.Footer(_resourcesText);
            return footer;
        }
    }

    private string _issueUrl => IssueLink.Build(
        Updates.Options.Repository, _kind, _title, _issueText, _issueFooter);

    private string _searchUrl => IssueLink.SearchUrl(Updates.Options.Repository, _title);
}

<style>
    .feedback-card {
        max-width: 60rem;
    }

    .feedback-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
    }

    .feedback-actions .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .feedback-checklist {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .feedback-check {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        cursor: pointer;
    }
</style>
