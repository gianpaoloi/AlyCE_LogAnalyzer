@page "/resources"
@inherits ObservingComponentBase
@implements IDisposable
@inject Localizer L
@inject LogStore Store
@inject LogWatcher Watcher
@inject NetworkLogListener Listener
@inject IJSRuntime JS
@inject NotificationService Notifications

<PageTitle>@L["resources.title"] · AlyCE Log Analyzer</PageTitle>

<RadzenText TextStyle="TextStyle.H4">@L["resources.title"]</RadzenText>
<RadzenText TextStyle="TextStyle.Body2" class="rz-mb-3 rz-color-muted">
    @L["resources.intro"]
</RadzenText>

<div class="res-grid">
    <RadzenCard Variant="Variant.Outlined">
        <div class="res-head">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2" title="@(L["resources.thisComputerTip"])">@L["resources.thisComputer"]</RadzenText>
            <RadzenButton Icon="content_copy" Text="@(L["resources.copy"])" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Click="CopyComputer" title="@(L["resources.copyTip"])" />
        </div>
        @if (_computer is not null && _snapshot is not null)
        {
            <div class="res-row" title="@(L["resources.machineTip"])"><span>@L["resources.machine"]</span><span>@_computer.MachineName</span></div>
            <div class="res-row" title="@(L["resources.osTip"])"><span>@L["resources.os"]</span><span>@_computer.OsDescription</span></div>
            <div class="res-row" title="@(L["resources.architectureTip"])"><span>@L["resources.architecture"]</span><span>@_computer.Architecture</span></div>
            <div class="res-row" title="@(L["resources.processorTip"])"><span>@L["resources.processor"]</span><span>@_computer.Processor</span></div>
            <div class="res-row" title="@(L["resources.logicalProcessorsTip"])"><span>@L["resources.logicalProcessors"]</span><span>@_computer.LogicalProcessors</span></div>
            <div class="res-row" title="@(L["resources.memoryTip"])"><span>@L["resources.memory"]</span><span>@L["resources.total", Format(_computer.TotalMemoryBytes)]</span></div>
            <div class="res-row" title="@(L["resources.runtimeTip"])"><span>@L["resources.runtime"]</span><span>@_computer.Runtime</span></div>
            <div class="res-row" title="@(L["resources.appVersionTip"])"><span>@L["resources.appVersion"]</span><span>@_computer.AppVersion</span></div>
            <div class="res-row" title="@(L["resources.computerRunningForTip"])"><span>@L["resources.computerRunningFor"]</span><span>@Duration(_snapshot.ComputerUptime)</span></div>
            <div class="res-row" title="@(L["resources.diskOfLogsTip"])">
                <span>@L["resources.diskOfLogs"]</span>
                <span>@(_snapshot.Disk is { } disk ? L["resources.diskFree", disk.Drive, Format(disk.FreeBytes), Format(disk.TotalBytes)] : L["resources.notAvailable"])</span>
            </div>
            <div class="res-row" title="@(L["resources.powerTip"])"><span>@L["resources.power"]</span><span>@PowerText(_snapshot.Power)</span></div>

            <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-3" title="@(L["resources.networkUpTip"])"><b>@L["resources.networkUp"]</b></RadzenText>
            @if (!_snapshot.Adapters.Any(IsListedAsUp))
            {
                <div class="res-row" title="@(L["resources.noAdapterUpTip"])"><span>@L["resources.none"]</span><span>@L["resources.noAdapterUp"]</span></div>
            }
            @foreach (var adapter in _snapshot.Adapters.Where(IsListedAsUp))
            {
                <div class="res-row" title="@(L["resources.speedTip"])">
                    <span>@adapter.Name</span>
                    <span>@(adapter.SpeedBitsPerSecond is long speed ? L["resources.mbps", (speed / 1_000_000).ToString("N0")] : L["resources.speedUnknown"])</span>
                </div>
            }

            <RadzenFieldset AllowCollapse="true" Collapsed="true"
                            Text="@(L["resources.otherAdapters", UnknownSpeed(_snapshot).Count])">
                <div title="@(L["resources.otherAdaptersTip"])">
                    @if (UnknownSpeed(_snapshot).Count == 0)
                    {
                        <div class="res-row" title="@(L["resources.allReportSpeedTip"])"><span>@L["resources.none"]</span><span>@L["resources.allReportSpeed"]</span></div>
                    }
                    @foreach (var adapter in UnknownSpeed(_snapshot))
                    {
                        <div class="res-row" title="@(L["resources.adapterStateTip"])">
                            <span>@adapter.Name</span>
                            <span>@(adapter.IsUp ? L["resources.up"] : L["resources.down"]), @L["resources.speedUnknown"]</span>
                        </div>
                    }
                </div>
            </RadzenFieldset>
        }
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined">
        <div class="res-head">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2" title="@(L["resources.computerUsageTip"])">@L["resources.computerUsage"]</RadzenText>
            <RadzenButton Icon="content_copy" Text="@(L["resources.copy"])" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Click="CopyUsage" title="@(L["resources.copyTip"])" />
        </div>
        @if (_snapshot is not null)
        {
            <Gauge Label="CPU" Percent="_snapshot.MachineCpuPercent"
                   Help="@(L["resources.cpuHelp"])" />
            <Sparkline Label="@(L["resources.computerCpu"])" Values="HistoryOf(s => s.MachineCpuPercent)"
                       Help="@(L["resources.computerCpuHelp"])" />
            <Gauge Label="@(L["resources.memory"])" Percent="MemoryPercent(_snapshot)"
                   Detail="@(L["resources.ofTotal", Format(_snapshot.MachineMemoryUsedBytes), Format(_snapshot.MachineMemoryTotalBytes)])"
                   Help="@(L["resources.memoryHelp"])" />
            <Sparkline Label="@(L["resources.computerMemory"])" Values="HistoryOf(s => (double?)MemoryPercent(s))"
                       Help="@(L["resources.computerMemoryHelp"])" />
        }
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined">
        <div class="res-head">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2" title="@(L["resources.thisAppTip"])">@L["resources.thisApp"]</RadzenText>
            <RadzenButton Icon="content_copy" Text="@(L["resources.copy"])" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                          Click="CopyApp" title="@(L["resources.copyTip"])" />
        </div>
        @if (_snapshot is not null)
        {
            <Gauge Label="CPU" Percent="_snapshot.AppCpuPercent"
                   Help="@(L["resources.appCpuHelp"])" />
            <Sparkline Label="@(L["resources.appCpu"])" Values="HistoryOf(s => s.AppCpuPercent)"
                       Help="@(L["resources.appCpuTrendHelp"])" />
            <Gauge Label="@(L["resources.memoryWorkingSet"])" Percent="AppMemoryPercent(_snapshot)"
                   Detail="@Format(_snapshot.AppWorkingSetBytes)"
                   Help="@(L["resources.workingSetHelp"])" />
            <Sparkline Label="@(L["resources.appMemory"])" Values="HistoryOf(s => (double?)AppMemoryPercent(s))"
                       Help="@(L["resources.appMemoryHelp"])" />
            <div class="res-row" title="@(L["resources.privateMemoryTip"])"><span>@L["resources.privateMemory"]</span><span>@Format(_snapshot.AppPrivateBytes)</span></div>
            <div class="res-row" title="@(L["resources.managedHeapTip"])"><span>@L["resources.managedHeap"]</span><span>@Format(_snapshot.ManagedHeapBytes)</span></div>
            <div class="res-row" title="@(L["resources.threadsTip"])"><span>@L["resources.threads"]</span><span>@_snapshot.Threads</span></div>
            <div class="res-row" title="@(L["resources.handlesTip"])"><span>@L["resources.handles"]</span><span>@_snapshot.Handles</span></div>
            <div class="res-row" title="@(L["resources.runningForTip"])"><span>@L["resources.runningFor"]</span><span>@Duration(_snapshot.AppUptime)</span></div>

            <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-3" title="@(L["resources.gcTip"])"><b>@L["resources.gc"]</b></RadzenText>
            <div class="res-row" title="@(L["resources.gcCollectionsTip"])"><span>@L["resources.gcCollections"]</span><span>@_snapshot.Gc.Gen0Collections.ToString("N0") / @_snapshot.Gc.Gen1Collections.ToString("N0") / @_snapshot.Gc.Gen2Collections.ToString("N0")</span></div>
            <div class="res-row" title="@(L["resources.timePausedTip"])"><span>@L["resources.timePaused"]</span><span>@PauseText(_snapshot.Gc.TotalPause)</span></div>
            <div class="res-row" title="@(L["resources.allocatedTip"])"><span>@L["resources.allocated"]</span><span>@Format(_snapshot.Gc.TotalAllocatedBytes)</span></div>

            <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-3" title="@(L["resources.loadedLogsTip"])"><b>@L["resources.loadedLogs"]</b></RadzenText>
            <div class="res-row" title="@(L["resources.rowsLoadedTip"])"><span>@L["resources.rowsLoaded"]</span><span>@Store.Entries.Count.ToString("N0")</span></div>
            <div class="res-row" title="@(L["resources.stateLoadTip"])"><span>@L["resources.state"]</span><span>@(Store.IsLoading ? L["resources.loading"] : Store.IsLoaded ? L["resources.loaded"] : L["resources.nothingLoaded"])</span></div>
            @if (Store.LastLoad is { } load)
            {
                <div class="res-row" title="@(L["resources.lastLoadTip"])"><span>@L["resources.lastLoad"]</span><span>@load.Source</span></div>
                <div class="res-row" title="@(L["resources.startedTip"])"><span>@L["resources.started"]</span><span>@load.StartedUtc.ToLocalTime().ToString("HH:mm:ss")</span></div>
                <div class="res-row" title="@(L["resources.durationTip"])"><span>@L["resources.duration"]</span><span>@Duration(load.Duration)</span></div>
                <div class="res-row" title="@(L["resources.rowsPerSecondTip"])"><span>@L["resources.rowsPerSecond"]</span><span>@load.RowsPerSecond.ToString("N0")</span></div>
                <div class="res-row" title="@(L["resources.bytesReadTip"])"><span>@L["resources.bytesRead"]</span><span>@(load.Bytes is long bytes ? Format(bytes) : L["resources.notKnown"])</span></div>
                <div class="res-row" title="@(L["resources.resultTip"])"><span>@L["resources.result"]</span><span>@(load.Succeeded ? L["resources.ok"] : L["resources.failedOrCancelled"])</span></div>
            }

            @if (Store.Grafana is { } download)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-3" title="@(L["resources.grafanaDownloadTip"])"><b>@L["resources.grafanaDownload"]</b></RadzenText>
                <div class="res-row" title="@(L["resources.downloadStateTip"])"><span>@L["resources.state"]</span><span>@(download.EndedUtc is null ? L["resources.downloading"] : L["resources.finishedAt", download.EndedUtc.Value.ToLocalTime().ToString("HH:mm:ss")])</span></div>
                <div class="res-row" title="@(L["resources.pagesTip"])"><span>@L["resources.pages"]</span><span>@download.Pages.ToString("N0")</span></div>
                <div class="res-row" title="@(L["resources.linesTip"])"><span>@L["resources.lines"]</span><span>@download.Lines.ToString("N0")</span></div>
                <div class="res-row" title="@(L["resources.linesPerSecondTip"])"><span>@L["resources.linesPerSecond"]</span><span>@download.LinesPerSecond(DateTime.UtcNow).ToString("N0")</span></div>
                <div class="res-row" title="@(L["resources.downloadedTip"])"><span>@L["resources.downloaded"]</span><span>@Format(download.Bytes)</span></div>
                <div class="res-row" title="@(L["resources.downloadSpeedTip"])"><span>@L["resources.downloadSpeed"]</span><span>@L["resources.perSecond", Format((long)download.BytesPerSecond(DateTime.UtcNow))]</span></div>
            }

            <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-3" title="@(L["resources.liveLogsTip"])"><b>@L["resources.liveLogs"]</b></RadzenText>
            <div class="res-row" title="@(L["resources.fileWatchTip"])"><span>@L["resources.fileWatch"]</span><span>@(Watcher.IsWatching ? L["resources.watching", Watcher.WatchedFile] : L["resources.off"])</span></div>
            <div class="res-row" title="@(L["resources.rowsFromWatchedTip"])"><span>@L["resources.rowsFromWatched"]</span><span>@Watcher.TotalEntries.ToString("N0")</span></div>
            <div class="res-row" title="@(L["resources.networkListenerTip"])"><span>@L["resources.networkListener"]</span><span>@(Listener.IsListening ? L["resources.listeningOn", Listener.Endpoint] : L["resources.off"])</span></div>
            <div class="res-row" title="@(L["resources.rowsOverNetworkTip"])"><span>@L["resources.rowsOverNetwork"]</span><span>@Listener.TotalEntries.ToString("N0")</span></div>
            <div class="res-row" title="@(L["resources.bytesOverNetworkTip"])"><span>@L["resources.bytesOverNetwork"]</span><span>@Format(Listener.TotalBytes)</span></div>
            <div class="res-row" title="@(L["resources.datagramsIgnoredTip"])"><span>@L["resources.datagramsIgnored"]</span><span>@Listener.Ignored.ToString("N0")</span></div>

            <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-2 rz-color-muted"
                        title="@(L["resources.captionTip"])">
                @L["resources.captionText"]
            </RadzenText>
        }
    </RadzenCard>
</div>

@code {
    private static readonly TimeSpan Interval = TimeSpan.FromSeconds(2);
    private const int HistoryLength = 120; // 120 samples at 2 seconds: the last 4 minutes

    private ComputerInfo? _computer;
    private ResourceSnapshot? _snapshot;
    private readonly List<ResourceSnapshot> _history = new();
    private ResourceSampler? _sampler;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        _computer = ResourceSampler.ReadComputerInfo();
        _sampler = new ResourceSampler();
        _snapshot = _sampler.Sample(Store.LoadedPath); // the baseline the first live reading is measured from
        _history.Add(_snapshot);
        _cts = new CancellationTokenSource();
        _ = RunAsync(_sampler, _cts.Token);
    }

    private async Task RunAsync(ResourceSampler sampler, CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(Interval);
            while (await timer.WaitForNextTickAsync(token))
            {
                var sample = sampler.Sample(Store.LoadedPath);
                RequestRefresh(() =>
                {
                    _snapshot = sample;
                    _history.Add(sample);
                    if (_history.Count > HistoryLength) _history.RemoveAt(0);
                });
            }
        }
        catch (OperationCanceledException)
        {
            // The page was left.
        }
        finally
        {
            sampler.Dispose();
        }
    }

    public void Dispose() => _cts?.Cancel();

    private List<double?> HistoryOf(Func<ResourceSnapshot, double?> pick) => _history.Select(pick).ToList();

    /// <summary>Every connection, up or down, that does not report a link speed. These are listed in the "Other network adapters" panel.</summary>
    private static List<AdapterSnapshot> UnknownSpeed(ResourceSnapshot snapshot) =>
        snapshot.Adapters.Where(a => a.SpeedBitsPerSecond is null).ToList();

    /// <summary>An up connection with a known speed. Only these appear in the "Network adapters (up)" list.</summary>
    private static bool IsListedAsUp(AdapterSnapshot adapter) => ResourceReport.IsListedAsUp(adapter);

    private static double MemoryPercent(ResourceSnapshot snapshot) => ResourceReport.MemoryPercent(snapshot);

    private static double AppMemoryPercent(ResourceSnapshot snapshot) => ResourceReport.AppMemoryPercent(snapshot);

    private static string PowerText(PowerSnapshot power) => ResourceReport.PowerText(power);

    private static string PauseText(TimeSpan pause) => ResourceReport.PauseText(pause);

    private static string Format(long bytes) => ResourceReport.Format(bytes);

    private static string Duration(TimeSpan span) => ResourceReport.Duration(span);

    private ResourceReportInput? Input() =>
        _computer is null || _snapshot is null
            ? null
            : ResourceReport.Input(_computer, _snapshot, Store, Watcher, Listener);

    private Task CopyComputer() => CopyAsync(i => ResourceReport.ComputerPanel(i));

    private Task CopyUsage() => CopyAsync(ResourceReport.UsagePanel);

    private Task CopyApp() => CopyAsync(i => ResourceReport.AppPanel(i));

    /// <summary>Copies one panel as text, with the machine name and file paths included: the user asked for it here.</summary>
    private async Task CopyAsync(Func<ResourceReportInput, ResourcePanel> build)
    {
        var input = Input();
        if (input is null) return;

        try
        {
            await JS.InvokeVoidAsync("copyTextToClipboard", ResourceReport.ToText(build(input)));
            Notifications.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = L["resources.copied"],
                Detail = L["resources.copiedDetail"],
                Duration = 2200,
            });
        }
        catch
        {
            // No clipboard (policy, or a non-secure context). The figures are on screen to be read off.
        }
    }
}

<style>
    .res-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
        max-width: 80rem;
    }

    .res-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.5rem;
    }

    .res-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.25rem 0;
        border-bottom: 1px solid rgba(127, 127, 127, 0.2);
    }

    .res-row > span:first-child { color: rgba(127, 127, 127, 0.9); }
    .res-row > span:last-child { text-align: right; word-break: break-word; }

    .res-gauge { margin: 0.5rem 0 0.25rem; }
    .res-gauge-head { display: flex; justify-content: space-between; font-size: 0.9rem; }
    .res-gauge-bar {
        height: 10px;
        border-radius: 5px;
        background: rgba(127, 127, 127, 0.25);
        overflow: hidden;
        margin-top: 0.3rem;
    }
    .res-gauge-fill { height: 100%; background: var(--rz-primary, #7c5cff); transition: width 0.4s ease; }

    .res-spark {
        display: block;
        width: 100%;
        height: 40px;
        margin: 0.2rem 0 0.6rem;
        color: var(--rz-primary, #7c5cff);
    }
</style>
