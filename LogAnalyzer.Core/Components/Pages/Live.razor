@page "/live"
@inject LogWatcher Watcher
@inject IConfiguration Config
@inject SessionState State
@inject DialogService DialogService
@inject PathHistory History
@inject IJSRuntime JS
@inherits ObservingComponentBase
@implements IDisposable

<PageTitle>File Live Watch · AlyCE Log Analyzer</PageTitle>

<RadzenText TextStyle="TextStyle.H4">File Live Watch</RadzenText>
<RadzenText TextStyle="TextStyle.Body2" class="rz-color-muted rz-mb-2">
    Tail a log file on a local or remote (UNC) path. New lines matching the filter appear in real time.
</RadzenText>

<RadzenCard Variant="Variant.Outlined" class="rz-mb-3">
    <div class="collapse-header @(State.LiveSettingsCollapsed ? "" : "rz-mb-2")" @onclick="ToggleSettings"
         title="@(State.LiveSettingsCollapsed ? "Expand watch settings" : "Collapse watch settings")">
        <RadzenIcon Icon="@(State.LiveSettingsCollapsed ? "expand_more" : "expand_less")" />
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0"><b>Watch settings</b></RadzenText>
        @if (State.LiveSettingsCollapsed)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-muted">@SettingsSummary()</RadzenText>
        }
    </div>

    @* Kept in the DOM while collapsed so the header combos don't lose their popup state. *@
    <div class="@(State.LiveSettingsCollapsed ? "collapse-hidden" : null)">
    <RadzenStack Gap="0.75rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.6rem" Wrap="FlexWrap.Wrap">
            @* Free-text box that also suggests previously watched files (see PathHistory). *@
            <RadzenAutoComplete @bind-Value="State.LivePath" Data="@_recentFiles"
                                Placeholder="\\server\share\Logs\all_2026-06-30.log"
                                OpenOnFocus="true" MinLength="0"
                                FilterOperator="StringFilterOperator.Contains"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Disabled="@Watcher.IsWatching" style="flex:1; min-width:320px"
                                title="Pick a file with Browse, or type/paste a path here" />
            <RadzenButton Text="Browse…" Icon="folder_open" Click="Browse" ButtonStyle="ButtonStyle.Secondary"
                          Disabled="@(Watcher.IsWatching || _starting)"
                          title="Pick a file — watching starts as soon as you select it" />
            <RadzenCheckBox @bind-Value="State.LiveFromStart" Name="fs" Disabled="@Watcher.IsWatching" />
            <RadzenLabel Text="from start" Component="fs" />
            @* Stays enabled while watching — freezing the grid mid-tail is exactly what it is for. *@
            <RadzenCheckBox @bind-Value="State.LiveAutoScroll" @bind-Value:after="OnAutoScrollChanged" Name="as" />
            <RadzenLabel Text="auto-scroll" Component="as"
                         title="Off: the grid keeps showing the lines on screen while the tail keeps buffering" />
            @if (Watcher.IsWatching)
            {
                <RadzenButton Text="Stop" Icon="stop" Click="Stop" ButtonStyle="ButtonStyle.Danger" />
            }
            else
            {
                <RadzenButton Text="@(_starting ? "Opening…" : "Start watching")" Icon="play_arrow" Click="Start"
                              ButtonStyle="ButtonStyle.Primary" Disabled="@_starting" />
            }
            <RadzenButton Text="Clear" Icon="clear_all" Click="Clear" ButtonStyle="ButtonStyle.Light" />
            <RadzenSplitButton Text="Download" Icon="download" Click="OnDownload" ButtonStyle="ButtonStyle.Success">
                <ChildContent>
                    <RadzenSplitButtonItem Text="CSV (.csv)" Value="csv" />
                    <RadzenSplitButtonItem Text="Log lines (.log)" Value="json" />
                </ChildContent>
            </RadzenSplitButton>
            <RadzenButton Icon="account_tree" Text="@(State.LiveShowLoggers ? "Hide loggers" : "Loggers")"
                          Click="@(() => State.LiveShowLoggers = !State.LiveShowLoggers)" ButtonStyle="ButtonStyle.Secondary" />
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.6rem" Wrap="FlexWrap.Wrap">
            @* Applies to the buffered lines as well as to the tail, so editing it changes what is
               on screen straight away instead of only affecting lines read after the change. *@
            <RadzenTextBox @bind-Value="State.LiveText" @bind-Value:after="OnTextFilterChanged"
                           Placeholder="text filter…" style="flex:1; min-width:220px" />
            <RadzenDropDown @bind-Value="State.LiveColumns" Multiple="true" AllowClear="true" Chips="true"
                            Placeholder="Add columns…" Data="@LogColumns.Optional"
                            TextProperty="Title" ValueProperty="Key" TValue="IEnumerable<string>" Style="width:300px" />
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-muted">Filter Level / Environment / Time / Message from the column headers</RadzenText>
        </RadzenStack>
    </RadzenStack>
    </div>
</RadzenCard>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2" Wrap="FlexWrap.Wrap">
    @if (Watcher.IsWatching)
    {
        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="watching" />
        <span class="mono">@Watcher.WatchedFile</span>
    }
    else
    {
        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="idle" />
    }
    <RadzenText TextStyle="TextStyle.Body2">· @Watcher.TotalEntries.ToString("N0") lines read · @_buffer.BufferedCount.ToString("N0") buffered</RadzenText>
    @if (Watcher.LastActivity is { } la)
    {
        <RadzenText TextStyle="TextStyle.Body2">· last @la.ToString("HH:mm:ss")</RadzenText>
    }
    @if (!string.IsNullOrEmpty(Watcher.LastError))
    {
        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@Watcher.LastError" />
    }
    @if (!State.LiveAutoScroll)
    {
        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="auto-scroll off" />
        <RadzenButton Text="@(_buffer.PendingCount > 0 ? $"Show {_buffer.PendingCount:N0} new lines" : "Resume")" Icon="play_arrow"
                      ButtonStyle="ButtonStyle.Warning" Variant="Variant.Outlined" Size="ButtonSize.Small"
                      Click="ResumeAutoScroll"
                      title="Turn auto-scroll back on and catch up with the tail" />
    }
    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-muted">· click a row for detail</RadzenText>
</RadzenStack>

<LiveGrid Data="@_buffer.Snapshot"
          @bind-Levels="State.LiveLevels" @bind-Levels:after="OnDisplayFilterChanged"
          @bind-Environments="State.LiveEnvironments" @bind-Environments:after="OnDisplayFilterChanged"
          @bind-Companies="State.LiveCompanies" @bind-Companies:after="OnDisplayFilterChanged"
          @bind-LoggerPrefix="State.LiveLoggerPrefix" @bind-LoggerPrefix:after="OnDisplayFilterChanged"
          Columns="@State.LiveColumns" AvailableColumns="@LogColumns.Optional"
          LevelOptions="@_buffer.Levels" EnvironmentOptions="@_buffer.Environments" CompanyOptions="@_buffer.Companies"
          Loggers="@_buffer.Loggers" ShowLoggers="@State.LiveShowLoggers"
          RowSelect="@OpenDetail" />

@code {
    // The tail produces faster than a browser can render. Queueing one refresh per poll (plus one per
    // status change) let the render queue grow without bound, which is what made a long watch freeze:
    // instead a single loop refreshes at most every RefreshInterval, only when something changed, and
    // awaits each render so it can never outrun the renderer.
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromMilliseconds(400);
    private readonly CancellationTokenSource _refreshCts = new();

    /// <summary>
    /// The buffered lines and everything collected from them (header combo values, logger tally),
    /// shared with Network Live Watch — see <see cref="LiveEntryBuffer"/> for the limits that keep a
    /// long watch flat. Per page, so leaving and coming back starts from an empty grid.
    /// </summary>
    private readonly LiveEntryBuffer _buffer = new();

    private List<string> _recentFiles = new();
    private bool _starting;     // guards against a second Start while a slow path is being opened

    protected override void OnInitialized()
    {
        // Seed the default path only the first time (so a user-edited path survives navigation).
        // The folder itself, not a made-up file name inside it: this used to append a hardcoded
        // "all_2026-06-30.log", so the first Start always failed on a file that never existed.
        // Browse opens the folder and the newest .log in it is listed first.
        if (string.IsNullOrEmpty(State.LivePath))
            State.LivePath = Config["LogAnalyzer:DefaultLogFolder"];
        // The buffer is per-page, so a fresh page has nothing to hold still: follow the tail again
        // even if auto-scroll was off when the user navigated away.
        State.LiveAutoScroll = true;
        // The text filter does survive navigation, so the buffer has to start out agreeing with the box.
        _buffer.TextFilter = State.LiveText;

        Watcher.EntriesAppended += OnEntries;
        Watcher.StatusChanged += OnStatus;
        _ = RefreshLoopAsync(_refreshCts.Token);
    }

    /// <summary>Single throttled refresh for everything the background tail changes.</summary>
    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (!_buffer.TakeDirty()) continue;

                // The snapshot is only rebuilt when the buffer moved — a status change on its own
                // (last-activity time, an error) just redraws.
                var rebuild = _buffer.TakeBufferDirty();
                await InvokeAsync(() =>
                {
                    // Not while frozen: the rows are meant to hold still, and handing Radzen a new
                    // Data reference makes it re-filter, re-sort and re-page for no visible change.
                    // The redraw still happens — the "N new lines" count is what moves.
                    if (rebuild && !_buffer.IsFrozen) Rebuild();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Page disposed.
        }
        catch (ObjectDisposedException)
        {
            // Circuit already gone; nothing left to refresh.
        }
        finally
        {
            // Disposed here rather than in Dispose(): cancelling and disposing back to back raced
            // this loop's own WaitForNextTickAsync, so leaving the page reliably threw (and swallowed)
            // an ObjectDisposedException.
            _refreshCts.Dispose();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // localStorage is only reachable once the component is interactive.
        if (!firstRender) return;
        _recentFiles = await History.GetAsync(PathHistory.LiveFileKey);
        if (_recentFiles.Count > 0) StateHasChanged();
    }

    /// <summary>Ingest. Runs on the watcher's poll thread; the buffer does the work off the renderer.</summary>
    private void OnEntries(IReadOnlyList<LogEntry> entries) => _buffer.Ingest(entries);

    private void Rebuild() => _buffer.Rebuild(new LiveDisplayFilter(
        State.LiveLevels, State.LiveEnvironments, State.LiveCompanies, State.LiveLoggerPrefix, State.LiveText));

    private void OnDisplayFilterChanged()
    {
        Rebuild();
        StateHasChanged();
    }

    /// <summary>
    /// The text box gates the tail as well as the display, so the buffer has to be told before it is
    /// re-filtered against the new value.
    /// </summary>
    private void OnTextFilterChanged()
    {
        _buffer.TextFilter = State.LiveText;
        OnDisplayFilterChanged();
    }

    /// <summary>Freezes the buffer as it is now, or releases it and catches up with the tail.</summary>
    private void OnAutoScrollChanged()
    {
        _buffer.Freeze(!State.LiveAutoScroll);
        Rebuild();
    }

    private void ResumeAutoScroll()
    {
        State.LiveAutoScroll = true;
        OnAutoScrollChanged();
    }

    private void ToggleSettings() => State.LiveSettingsCollapsed = !State.LiveSettingsCollapsed;

    /// <summary>One-line recap of the folded panel: which file, and whether a text filter is on.</summary>
    private string SettingsSummary()
    {
        var path = State.LivePath;
        var file = string.IsNullOrWhiteSpace(path) ? "no file selected" : Path.GetFileName(path.TrimEnd('\\', '/'));
        if (string.IsNullOrWhiteSpace(file)) file = path!;
        return string.IsNullOrWhiteSpace(State.LiveText) ? file : $"{file} · text \"{State.LiveText}\"";
    }

    // Export the currently displayed snapshot (CSV by default; .log = original JSON lines).
    private async Task OnDownload(RadzenSplitButtonItem? item)
    {
        var rows = _buffer.Snapshot;
        if (rows.Count == 0) return;
        var json = item?.Value == "json";
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        var name = json ? $"live-logs-{stamp}.log" : $"live-logs-{stamp}.csv";

        await using var stream = await LogExport.OpenExportAsync(rows, json);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", name, streamRef);
    }

    // Same detail dialog as the Explorer grid. The entry is a snapshot, so the tail can keep
    // appending behind the dialog without changing what is on screen.
    private async Task OpenDetail(LogEntry e)
    {
        await DialogService.OpenAsync<LogDetail>(
            $"{e.Level} · {e.Time:HH:mm:ss.fff}",
            new Dictionary<string, object?> { { "Entry", e } },
            new DialogOptions { Width = "900px", Height = "auto", Resizable = true, Draggable = true });
    }

    // File picker, so the path never has to be typed. It browses the machine that reads the logs,
    // which is the same one LogWatcher tails from.
    private async Task Browse()
    {
        var start = string.IsNullOrWhiteSpace(State.LivePath)
            ? Config["LogAnalyzer:DefaultLogFolder"]
            : State.LivePath;

        var picked = await DialogService.OpenAsync<FileBrowserDialog>("Select the log file to watch",
            new Dictionary<string, object?> { { "StartPath", start } },
            new DialogOptions
            {
                Width = "820px",
                Height = "640px",
                Resizable = true,
                Draggable = true,
                // Same glyph as the Browse… button that opens it, so the dialog is recognisably the
                // thing that was just clicked.
                Icon = "folder_open",
                // Puts the class on Radzen's .rz-dialog-content box. That element is an *ancestor* of
                // FileBrowserDialog, and Blazor's scoped CSS can only reach descendants, so the one
                // rule that has to change there lives in app.css. See ".fb-dialog-content" for why.
                ContentCssClass = "fb-dialog-content",
            });

        if (picked is not string path || path.Length == 0) return;

        State.LivePath = path;
        // Browsed to it, so it exists — remember it right away instead of waiting for Start.
        _recentFiles = await History.AddAsync(PathHistory.LiveFileKey, path);
        // Picking a file is the whole point of the dialog, so start tailing it without a second click.
        await Start();
    }

    private async Task Start()
    {
        if (_starting || string.IsNullOrWhiteSpace(State.LivePath)) return;
        var path = State.LivePath.Trim();

        // Off the UI thread: opening a wrong or offline UNC path blocks for tens of seconds inside
        // the watcher's existence check, and the page must stay usable meanwhile.
        _starting = true;
        try
        {
            // StartAsync does its own blocking probe on a worker thread, and waits for any previous
            // poll loop to finish before touching the shared read position.
            await Watcher.StartAsync(path, State.LiveFromStart);
        }
        finally
        {
            _starting = false;
        }

        // Only remember a path that actually opened, so typos stay out of the suggestions.
        if (Watcher.IsWatching)
            _recentFiles = await History.AddAsync(PathHistory.LiveFileKey, path);
    }

    private Task Stop() => Watcher.StopAsync();

    private void Clear()
    {
        _buffer.Clear();
        Rebuild();
    }

    // Raised from the poll thread: flag it and let the refresh loop pick it up.
    private void OnStatus() => _buffer.MarkDirty();

    public void Dispose()
    {
        Watcher.EntriesAppended -= OnEntries;
        Watcher.StatusChanged -= OnStatus;
        _refreshCts.Cancel();
        // The loop disposes its own token source once it has unwound.
        // Watcher is a singleton and keeps running so the tail survives navigation.
    }
}
