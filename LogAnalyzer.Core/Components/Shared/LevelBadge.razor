@* Colored Radzen badge for a log level. *@
<RadzenBadge BadgeStyle="@Style" Text="@Level" />

@code {
    [Parameter] public string? Level { get; set; }

    private BadgeStyle Style => (Level ?? "").ToUpperInvariant() switch
    {
        "ERROR" or "FATAL" => BadgeStyle.Danger,
        "WARN" or "WARNING" => BadgeStyle.Warning,
        "INFO" => BadgeStyle.Info,
        "DEBUG" => BadgeStyle.Light,
        _ => BadgeStyle.Secondary,
    };
}
