@* Colored Radzen badge for a log level. *@
<RadzenBadge BadgeStyle="@Style" Text="@Level" />

@code {
    [Parameter] public string? Level { get; set; }

    // Via LogLevels so the badge, the chart and the colours agree on WARN/WARNING and ERROR/FATAL,
    // and without the uppercased copy this used to allocate for every rendered row.
    private BadgeStyle Style => LogLevels.Series(Level) switch
    {
        LogLevels.Error => BadgeStyle.Danger,
        LogLevels.Warn => BadgeStyle.Warning,
        LogLevels.Info => BadgeStyle.Info,
        LogLevels.Debug => BadgeStyle.Light,
        _ => BadgeStyle.Secondary,
    };
}
