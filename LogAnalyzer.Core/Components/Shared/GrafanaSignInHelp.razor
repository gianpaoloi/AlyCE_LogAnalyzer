@* Popup from the "?" beside the sign-in box of GrafanaImportDialog. Shows only the section for the current mode. *@
@inject Localizer L
@inject DialogService DialogService

<RadzenStack Gap="1rem">

    @if (!UseToken)
    {
        <RadzenStack Gap="0.4rem">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0"><b>@L["signin.cookieTitle"]</b></RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                @L["signin.cookieIntro"]
            </RadzenText>
            <ol class="rz-m-0" style="padding-left:1.3rem">
                <li>@((MarkupString)L["signin.cookieStep1"])</li>
                <li>@((MarkupString)L["signin.cookieStep2"])</li>
                <li>@((MarkupString)L["signin.cookieStep3"])</li>
                <li>@((MarkupString)L["signin.cookieStep4"])</li>
                <li>@((MarkupString)L["signin.cookieStep5"])</li>
                <li>@((MarkupString)L["signin.cookieStep6"])</li>
            </ol>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-muted">
                @((MarkupString)L["signin.cookieNote"])
            </RadzenText>
        </RadzenStack>
    }
    else
    {
        <RadzenStack Gap="0.4rem">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0"><b>@L["signin.tokenTitle"]</b></RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                @L["signin.tokenIntro"]
            </RadzenText>
            <ol class="rz-m-0" style="padding-left:1.3rem">
                <li>@((MarkupString)L["signin.tokenStep1"])</li>
                <li>@((MarkupString)L["signin.tokenStep2"])</li>
                <li>@((MarkupString)L["signin.tokenStep3"])</li>
                <li>@((MarkupString)L["signin.tokenStep4"])</li>
            </ol>
        </RadzenStack>
    }

    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-muted">
        @((MarkupString)L["signin.safety"])
    </RadzenText>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
        <RadzenButton Text="@(L["signin.close"])" ButtonStyle="ButtonStyle.Primary" Click="() => DialogService.Close()" />
    </RadzenStack>
</RadzenStack>

@code {
    /// <summary>True for the service account token section, false for the grafana_session cookie section.</summary>
    [Parameter] public bool UseToken { get; set; }
}
