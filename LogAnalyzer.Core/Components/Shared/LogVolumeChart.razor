@* Grafana-style log volume panel: stacked bars per time bucket, auto bucket size,
   level totals in the legend. Pure CSS/HTML (no SVG) so it scales with the container.
   Doubles as a filter: drag across the bars to pick a time window, click a legend
   entry to toggle that level. *@

<div class="lv-panel">
    <div class="lv-head">
        <span class="lv-head-toggle" @onclick="ToggleCollapsed"
              title="@(Collapsed ? "Expand chart" : "Collapse chart")">
            <RadzenIcon Icon="@(Collapsed ? "chevron_right" : "expand_more")" />
            <span class="lv-title">@Title (@Compact(_total))</span>
        </span>

        @if (Range is { } r)
        {
            <span class="lv-range" title="Selected time window">
                <RadzenIcon Icon="schedule" />
                @r.ToString()
                <span class="lv-range-clear" title="Clear time filter" @onclick="ClearRange">
                    <RadzenIcon Icon="close" />
                </span>
            </span>
        }

        @if (!Collapsed && _bucketLabel is not null)
        {
            <span class="lv-bucket">
                @if (Range is null)
                {
                    <span class="lv-hint">drag to filter a time window &middot; </span>
                }
                @_bucketLabel per bar
            </span>
        }
    </div>

    @if (!Collapsed)
    {
        @if (_buckets.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-color-muted rz-m-0">No timestamped entries.</RadzenText>
        }
        else
        {
            <div class="lv-body">
                <div class="lv-yaxis">
                    @foreach (var t in _yTicks)
                    {
                        <span class="lv-ytick" style="bottom:@Pct(t / _yMax)">@Compact((long)Math.Round(t))</span>
                    }
                </div>
                <div class="lv-plot">
                    @foreach (var t in _yTicks)
                    {
                        <div class="lv-gridline" style="bottom:@Pct(t / _yMax)"></div>
                    }
                    @foreach (var i in _xTicks)
                    {
                        <div class="lv-gridline-v" style="left:@Pct((i + 0.5) / _buckets.Count)"></div>
                    }
                    @* mouseleave also ends the drag, so releasing outside the plot can't leave it stuck *@
                    <div class="lv-bars" @onmouseup="EndDrag" @onmouseleave="EndDrag">
                        @for (var i = 0; i < _buckets.Count; i++)
                        {
                            var idx = i;
                            var b = _buckets[idx];
                            <div class="lv-bar @BarClass(idx)" title="@Tooltip(b)"
                                 @onmousedown="() => StartDrag(idx)" @onmousedown:preventDefault="true"
                                 @onmouseenter="() => ExtendDrag(idx)">
                                @* top-to-bottom markup, pushed to the baseline: error on top, debug at the bottom *@
                                <span class="lv-seg" style="@Seg(b.Error, "ERROR")"></span>
                                <span class="lv-seg" style="@Seg(b.Warn, "WARN")"></span>
                                <span class="lv-seg" style="@Seg(b.Info, "INFO")"></span>
                                <span class="lv-seg" style="@Seg(b.Other, "OTHER")"></span>
                                <span class="lv-seg" style="@Seg(b.Debug, "DEBUG")"></span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="lv-xaxis">
                @foreach (var i in _xTicks)
                {
                    <span class="lv-xtick" style="left:@Pct((i + 0.5) / _buckets.Count)">@_buckets[i].Start.ToString(_tickFormat)</span>
                }
            </div>

            <div class="lv-legend">
                @foreach (var (name, key, count) in Series())
                {
                    <button type="button" class="lv-legend-item @(IsLevelActive(key) ? "lv-legend-on" : null)"
                            title="@(IsLevelActive(key) ? $"Stop filtering by {name}" : $"Filter by {name}")"
                            @onclick="() => LevelToggled.InvokeAsync(key)">
                        <i style="background:@ChartColors.Level(key)"></i>@name
                        <span class="lv-legend-total">Total: @Compact(count)</span>
                    </button>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<LogEntry> Entries { get; set; } = Array.Empty<LogEntry>();
    [Parameter] public string Title { get; set; } = "Log volume";

    /// <summary>Collapsed state; supports <c>@bind-Collapsed</c> so the caller can persist it.</summary>
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }

    /// <summary>
    /// The selected time window, highlighted on the bars. Supports <c>@bind-Range</c>.
    /// Feed <see cref="Entries"/> with the set filtered by everything *except* this window,
    /// so the whole timeline stays visible and the selection can be moved or widened.
    /// </summary>
    [Parameter] public TimeRange? Range { get; set; }
    [Parameter] public EventCallback<TimeRange?> RangeChanged { get; set; }

    /// <summary>Levels currently filtered on, used to light up the matching legend entries.</summary>
    [Parameter] public IEnumerable<string>? ActiveLevels { get; set; }

    /// <summary>Raised with a series key (<c>INFO</c>, <c>WARN</c>, …) when a legend entry is clicked.</summary>
    [Parameter] public EventCallback<string> LevelToggled { get; set; }

    /// <summary>
    /// Maps a raw level string onto the chart's five stacked series. Shared with the badges, the
    /// colours and the stats buckets, and allocation-free — this is called once per entry while
    /// bucketing, and once per rendered segment.
    /// </summary>
    public static string SeriesKey(string level) => LogLevels.Series(level);

    private sealed class Bucket
    {
        public DateTime Start;
        public double Debug, Info, Warn, Error, Other;
        public double Total => Debug + Info + Warn + Error + Other;
    }

    // Bucket sizes offered, smallest first — the first one that keeps the bar count
    // under MaxBars wins, so the axis always uses a round, human-readable step.
    private static readonly TimeSpan[] Steps =
    {
        TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(30),
        TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(5), TimeSpan.FromMinutes(10), TimeSpan.FromMinutes(30),
        TimeSpan.FromHours(1), TimeSpan.FromHours(3), TimeSpan.FromHours(6), TimeSpan.FromHours(12),
        TimeSpan.FromDays(1), TimeSpan.FromDays(7), TimeSpan.FromDays(30),
    };
    private const int MaxBars = 180;
    private const int MaxXTicks = 10;
    private const int YTickTarget = 4;

    private List<Bucket> _buckets = new();
    private List<int> _xTicks = new();
    private double[] _yTicks = Array.Empty<double>();
    private double _yMax = 1;
    private long _total;
    private string? _bucketLabel;
    private string _tickFormat = "MM/dd HH:mm";
    private TimeSpan _step = TimeSpan.FromHours(1);
    private IReadOnlyList<LogEntry>? _built;

    // In-progress drag selection (bar indices, either order).
    private int? _dragFrom;
    private int? _dragTo;
    private bool _skipRender;

    // Every bar listens for mouseenter so a drag can track the cursor, which means merely
    // hovering the chart raises ~one event per bar. Those that change nothing skip the
    // re-render instead of diffing all the bars again.
    protected override bool ShouldRender()
    {
        if (!_skipRender) return true;
        _skipRender = false;
        return false;
    }

    protected override void OnParametersSet()
    {
        // Explorer hands us a fresh list on every filter change, so a reference
        // check is enough to avoid re-bucketing hundreds of thousands of entries.
        if (!ReferenceEquals(_built, Entries))
        {
            _built = Entries;
            Build();
        }
    }

    private void Build()
    {
        _buckets = new List<Bucket>();
        _xTicks = new List<int>();
        _yTicks = Array.Empty<double>();
        _yMax = 1;
        _total = Entries.Count;
        _bucketLabel = null;
        _dragFrom = _dragTo = null;

        // Two cheap passes over the (potentially huge) filtered set: range, then fill.
        DateTime first = DateTime.MaxValue, last = DateTime.MinValue;
        var timed = 0;
        foreach (var e in Entries)
        {
            if (e.Time == default) continue;
            timed++;
            if (e.Time < first) first = e.Time;
            if (e.Time > last) last = e.Time;
        }
        if (timed == 0) return;

        _step = Steps.FirstOrDefault(s => (last - first).TotalSeconds / s.TotalSeconds < MaxBars, Steps[^1]);
        _bucketLabel = Describe(_step);
        _tickFormat = _step >= TimeSpan.FromDays(1) ? "MM/dd" : "MM/dd HH:mm";

        var origin = Floor(first, _step);
        var count = (int)((Floor(last, _step) - origin).Ticks / _step.Ticks) + 1;
        for (var i = 0; i < count; i++)
            _buckets.Add(new Bucket { Start = origin + i * _step });

        foreach (var e in Entries)
        {
            if (e.Time == default) continue;
            var b = _buckets[(int)((Floor(e.Time, _step) - origin).Ticks / _step.Ticks)];
            switch (SeriesKey(e.Level))
            {
                case LogLevels.Debug: b.Debug++; break;
                case LogLevels.Info: b.Info++; break;
                case LogLevels.Warn: b.Warn++; break;
                case LogLevels.Error: b.Error++; break;
                default: b.Other++; break;
            }
        }

        // Scale follows the data: a round tick step, then the axis top is the first
        // multiple of it at or above the busiest bucket — never a fixed ceiling.
        var peak = _buckets.Max(b => b.Total);
        var tick = NiceTick(peak);
        _yMax = Math.Max(tick, Math.Ceiling(peak / tick) * tick);
        _yTicks = Enumerable.Range(1, (int)Math.Round(_yMax / tick)).Select(i => i * tick).ToArray();

        var every = Math.Max(1, (int)Math.Ceiling(_buckets.Count / (double)MaxXTicks));
        for (var i = 0; i < _buckets.Count; i += every) _xTicks.Add(i);
    }

    private static DateTime Floor(DateTime t, TimeSpan step) => new(t.Ticks - (t.Ticks % step.Ticks), t.Kind);

    /// <summary>
    /// Gap between y ticks: a round 1 / 2 / 2.5 / 5 / 10 × 10ⁿ value that splits the peak into
    /// roughly <see cref="YTickTarget"/> bands. Never below 1, since bars count whole entries.
    /// </summary>
    private static double NiceTick(double peak)
    {
        if (peak <= 0) return 1;
        var raw = peak / YTickTarget;
        var mag = Math.Pow(10, Math.Floor(Math.Log10(raw)));
        var norm = raw / mag;
        var nice = norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 2.5 ? 2.5 : norm <= 5 ? 5 : 10;
        return Math.Max(1, nice * mag);
    }

    private static string Describe(TimeSpan s) =>
        s.TotalDays >= 1 ? $"{s.TotalDays:0}d" :
        s.TotalHours >= 1 ? $"{s.TotalHours:0}h" :
        s.TotalMinutes >= 1 ? $"{s.TotalMinutes:0}m" : $"{s.TotalSeconds:0}s";

    private static string Compact(long v) =>
        v >= 1_000_000 ? $"{v / 1_000_000.0:0.##}M" :
        v >= 1_000 ? $"{v / 1_000.0:0.##}K" : v.ToString("N0");

    /// <summary>
    /// A percentage for a CSS declaration, formatted invariantly.
    /// <para>
    /// The invariant part is the whole point. This value goes straight into inline CSS, and on a
    /// culture with a comma decimal separator — it-IT, de-DE, fr-FR, most of Europe — the current
    /// culture turns 1.9 into "1,9%", which is not a length any browser accepts. The declaration is
    /// dropped silently, the bar segment falls back to its <c>min-height: 1px</c>, and only the
    /// segments whose percentage happened to come out a whole number were ever drawn to scale: a
    /// 1 590-entry bucket rendered 3px tall (1px per level) next to a 343-entry one at 20px, which
    /// is what made the y axis look wrong when the axis was in fact the only part that was right.
    /// The same formatting positions the gridlines and the tick labels, so the x axis collapsed its
    /// labels onto the left edge for the same reason.
    /// </para>
    /// </summary>
    private static string Pct(double f) => FormattableString.Invariant($"{Math.Clamp(f, 0, 1) * 100:0.###}%");

    /// <summary>Segment style; a non-empty segment always keeps a visible sliver (like Grafana).</summary>
    private string Seg(double count, string level) => count <= 0
        ? "display:none"
        : $"height:{Pct(count / _yMax)};min-height:1px;background:{ChartColors.Level(level)}";

    private IEnumerable<(string Name, string Key, long Count)> Series()
    {
        var rows = new (string Name, string Key, long Count)[]
        {
            ("debug", LogLevels.Debug, (long)_buckets.Sum(b => b.Debug)),
            ("info", LogLevels.Info, (long)_buckets.Sum(b => b.Info)),
            ("warn", LogLevels.Warn, (long)_buckets.Sum(b => b.Warn)),
            ("error", LogLevels.Error, (long)_buckets.Sum(b => b.Error)),
            ("other", LogLevels.Other, (long)_buckets.Sum(b => b.Other)),
        };
        return rows.Where(r => r.Count > 0);
    }

    private bool IsLevelActive(string seriesKey) =>
        ActiveLevels is not null && ActiveLevels.Any(l => SeriesKey(l) == seriesKey);

    private string Tooltip(Bucket b)
    {
        var parts = new List<string>();
        if (b.Debug > 0) parts.Add($"debug {b.Debug:N0}");
        if (b.Info > 0) parts.Add($"info {b.Info:N0}");
        if (b.Warn > 0) parts.Add($"warn {b.Warn:N0}");
        if (b.Error > 0) parts.Add($"error {b.Error:N0}");
        if (b.Other > 0) parts.Add($"other {b.Other:N0}");
        var detail = parts.Count > 0 ? $" ({string.Join(", ", parts)})" : "";
        return $"{b.Start:yyyy-MM-dd HH:mm:ss} · {b.Total:N0} entries{detail} — drag to filter";
    }

    /// <summary>Highlight for a bar: the live drag wins, otherwise the committed window.</summary>
    private string? BarClass(int i)
    {
        if (_dragFrom is { } a && _dragTo is { } z)
            return i >= Math.Min(a, z) && i <= Math.Max(a, z) ? "lv-bar-sel" : "lv-bar-dim";

        if (Range is { } r)
            return r.Overlaps(_buckets[i].Start, _step) ? "lv-bar-sel" : "lv-bar-dim";

        return null;
    }

    private void StartDrag(int i) { _dragFrom = i; _dragTo = i; }

    private void ExtendDrag(int i)
    {
        if (_dragFrom is null || _dragTo == i) { _skipRender = true; return; }
        _dragTo = i;
    }

    /// <summary>Commits the drag as a time window. A plain click selects the single bucket under the cursor.</summary>
    private async Task EndDrag()
    {
        if (_dragFrom is not { } a || _dragTo is not { } z) { _skipRender = true; return; }
        _dragFrom = _dragTo = null;

        var (lo, hi) = (Math.Min(a, z), Math.Max(a, z));
        var from = _buckets[lo].Start;
        var to = _buckets[hi].Start + _step - TimeSpan.FromTicks(1);

        Range = new TimeRange(from, to);
        await RangeChanged.InvokeAsync(Range);
    }

    private async Task ClearRange()
    {
        Range = null;
        await RangeChanged.InvokeAsync(null);
    }

    private Task ToggleCollapsed()
    {
        Collapsed = !Collapsed;
        return CollapsedChanged.InvokeAsync(Collapsed);
    }
}
