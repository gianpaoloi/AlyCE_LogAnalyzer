@* Folder input + load button + progress, built with Radzen. Reflects shared LogStore state. *@
@implements IDisposable
@inject LogStore Store
@inject IConfiguration Config
@inject IJSRuntime JS
@inject SessionState State
@inject PathHistory History

<RadzenCard class="rz-mb-3" Variant="Variant.Outlined">
    <div class="collapse-header @(Collapsed ? "" : "rz-mb-2")" @onclick="Toggle"
         title="@(Collapsed ? "Expand load files" : "Collapse load files")">
        <RadzenIcon Icon="@(Collapsed ? "expand_more" : "expand_less")" />
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0"><b>Load files</b></RadzenText>
        @if (Collapsed)
        {
            @if (Store.IsLoading)
            {
                <LoadProgress Compact="true" />
            }
            else if (Store.IsLoaded)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-muted">
                    @Store.Stats!.TotalEntries.ToString("N0") entries &middot;
                    @Store.Stats.FileCount files &middot; @Store.LoadedPath
                </RadzenText>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-muted">nothing loaded</RadzenText>
            }
        }
    </div>

    @* Kept in the DOM while collapsed so the drop zone's JS registration and the
       typed folder path survive a collapse/expand round-trip. *@
    <div class="@(Collapsed ? "collapse-hidden" : null)">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.6rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mr-1"><b>Log folder</b></RadzenText>
        @* Free-text box that also suggests previously loaded folders (see PathHistory). *@
        <RadzenAutoComplete @bind-Value="_folder" Data="@_recentFolders"
                            Placeholder="C:\path\to\Logs or \\server\share\Logs"
                            OpenOnFocus="true" MinLength="0"
                            FilterOperator="StringFilterOperator.Contains"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Disabled="@Store.IsLoading" style="flex:1; min-width:280px"
                            title="Type a path, or pick one you used before" />
        <RadzenCheckBox @bind-Value="Store.IncludeDebug" Name="dbg" Disabled="@Store.IsLoading" />
        <RadzenLabel Text="include DEBUG" Component="dbg" title="Including DEBUG uses much more memory" />
        @if (Store.IsLoading)
        {
            <LoadProgress />
        }
        else
        {
            <RadzenButton Text="@(Store.IsLoaded ? "Reload" : "Load")" Icon="folder_open"
                          Click="Load" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton Text="Clear" Icon="delete_sweep" Click="Clear"
                          ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                          Disabled="@(!Store.IsLoaded)" />
        }
    </RadzenStack>

    @* The zone stays rendered while loading (it holds the JS drop registration) but ignores
       input — the busy class makes that visible instead of silently swallowing a drop. *@
    <div class="drop-zone rz-mt-2 @(Store.IsLoading ? "drop-zone-busy" : null)" @ref="_dropZoneRef">
        <InputFile id="@_inputId" class="drop-zone-input" OnChange="OnDropZoneSelected" accept=".log,.zip" multiple />
        @if (Store.IsLoading)
        {
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false"
                                       Size="ProgressBarCircularSize.Small"
                                       ProgressBarStyle="ProgressBarStyle.Info" />
            <span>Loading logs&#x2026;</span>
        }
        else
        {
            <RadzenIcon Icon="move_to_inbox" />
            <span>Click to load log Files, zip in the app or Drop it</span>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(_dropError))
    {
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-danger rz-mt-1">@_dropError</RadzenText>
    }

    @if (Store.IsLoading)
    {
        var pct = Store.FilesTotal > 0 ? (Store.FilesProcessed * 100.0 / Store.FilesTotal) : 0;
        <RadzenProgressBar Value="@pct" ShowValue="false" class="rz-mt-2" />
    }
    else if (!string.IsNullOrEmpty(Store.LoadError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter"
                     AllowClose="false" class="rz-mt-2">@Store.LoadError</RadzenAlert>
    }
    else if (Store.IsLoaded)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2 rz-color-success">
            Loaded <b>@Store.Stats!.TotalEntries.ToString("N0")</b> entries from
            <b>@Store.Stats.FileCount</b> files &middot; @Store.LoadedPath
        </RadzenText>
    }
    </div>
</RadzenCard>

@code {
    // Collapsed state is shared by every page hosting the panel (and kept in SessionState),
    // so folding it away on one page keeps it folded when navigating to another.
    private bool Collapsed => State.LoadPanelCollapsed;

    private void Toggle() => State.LoadPanelCollapsed = !State.LoadPanelCollapsed;

    private string _folder = "";
    private string? _dropError;
    private ElementReference _dropZoneRef;
    private readonly string _inputId = $"drop-input-{Guid.NewGuid():N}";
    private bool _jsRegistered;
    private List<string> _recentFolders = new();

    protected override void OnInitialized()
    {
        _folder = Store.LoadedPath ?? Config["LogAnalyzer:DefaultLogFolder"] ?? "";
        Store.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("registerNativeDropInput", _dropZoneRef, _inputId);
                _jsRegistered = true;
            }
            catch { /* JS not yet available during pre-render */ }

            // localStorage is only reachable once the component is interactive.
            _recentFolders = await History.GetAsync(PathHistory.LogFolderKey);
            if (_recentFolders.Count > 0) StateHasChanged();
        }
    }

    // Remembered only after a load succeeds, so typos don't end up in the suggestions.
    private async Task Load()
    {
        if (string.IsNullOrWhiteSpace(_folder)) return;
        var folder = _folder.Trim();
        await Store.LoadAsync(folder, Store.IncludeDebug, null, CancellationToken.None);
        if (string.IsNullOrEmpty(Store.LoadError))
            _recentFolders = await History.AddAsync(PathHistory.LogFolderKey, folder);
    }

    private void Clear()
    {
        Store.Clear();
        _dropError = null;
    }

    private async Task OnDropZoneSelected(InputFileChangeEventArgs e)
    {
        if (Store.IsLoading) return;

        var files = e.GetMultipleFiles(100);
        if (files is null || files.Count == 0) return;

        var zipFiles = files.Where(f => f.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase)).ToList();
        var logFiles = files.Where(f => f.Name.EndsWith(".log", StringComparison.OrdinalIgnoreCase)).ToList();

        if (zipFiles.Count > 1 || (zipFiles.Count > 0 && logFiles.Count > 0))
        {
            _dropError = "Use one ZIP file or one/more LOG files, not both together.";
            return;
        }

        if (zipFiles.Count == 1)
        {
            _dropError = null;
            var zip = zipFiles[0];
            const long maxZipBytes = 2L * 1024 * 1024 * 1024;
            await using var stream = zip.OpenReadStream(maxZipBytes);
            await Store.LoadFromZipAsync(stream, zip.Name, Store.IncludeDebug, CancellationToken.None);
            return;
        }

        if (logFiles.Count > 0)
        {
            _dropError = null;
            const long maxLogBytes = 500L * 1024 * 1024;
            foreach (var file in logFiles)
            {
                await using var stream = file.OpenReadStream(maxLogBytes);
                await Store.EnqueueFromFileAsync(stream, file.Name, Store.IncludeDebug, CancellationToken.None);
            }
            return;
        }

        _dropError = "Only .zip and .log files are supported.";
    }

    private async void OnChanged() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Store.Changed -= OnChanged;
        if (_jsRegistered)
            _ = JS.InvokeVoidAsync("unregisterNativeDropInput", _dropZoneRef);
    }
}
