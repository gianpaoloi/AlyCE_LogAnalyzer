<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LogAnalyzer</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" Version="11.0.5" />
    <PackageReference Include="Markdig" Version="1.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI translations: one file per area, each key with its English, Italian and Albanian text. -->
    <EmbeddedResource Include="Localization/*.json" />
  </ItemGroup>

</Project>
