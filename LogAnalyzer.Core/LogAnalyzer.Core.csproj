<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LogAnalyzer</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" Version="11.0.5" />
    <PackageReference Include="Markdig" Version="1.1.3" />
    <!-- AI: Microsoft Agent Framework agents over the vendor SDKs' chat clients (see Services/Ai). -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.1" />
    <PackageReference Include="OpenAI" Version="2.15.0" />
    <PackageReference Include="Anthropic" Version="13.13.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI translations: one file per area, each key with its English, Italian and Albanian text. -->
    <EmbeddedResource Include="Localization/*.json" />
  </ItemGroup>

</Project>
